import 'dart:io';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:omi/ella/ella_theme.dart';
import 'package:omi/l10n/app_localizations.dart';
import 'package:omi/ella/upstream_capture/ella_home_transcript_panel.dart';
import 'package:omi/stock_capture/pages/conversations/widgets/live_capture_card.dart';
void main(){
 setUpAll(()async{await (FontLoader('.SF UI Text')..addFont(File('/System/Library/Fonts/SFNS.ttf').readAsBytes().then(ByteData.sublistView))).load();});
 for(final dark in [false,true]){for(final scale in [1.0,3.5]){
 testWidgets('full Home capture state is visually readable dark=$dark scale=$scale',(t)async{
  t.view.physicalSize=const Size(390,844);t.view.devicePixelRatio=1;addTearDown(t.view.resetPhysicalSize);addTearDown(t.view.resetDevicePixelRatio);
  const status='Necklace connected · waiting for audio';
  await t.pumpWidget(MaterialApp(theme:ellaThemeData(dark:dark),localizationsDelegates:AppLocalizations.localizationsDelegates,supportedLocales:AppLocalizations.supportedLocales,home:MediaQuery(data:MediaQueryData(size:const Size(390,844),textScaler:TextScaler.linear(scale)),child:Scaffold(body:Center(child:SizedBox(width:390,child:EllaHomeTranscriptCard(status:status,lastAudio:'Last audio: not observed',transcription:'Transcription not confirmed',preview:'Fictional words',onOpen:(){},stockCapture:LiveCaptureCard(source:'omi',status:status,compact:true,onPauseToggle:(){}))))))));
  final p=t.renderObject<RenderParagraph>(find.text(status));
  expect(p.didExceedMaxLines,false,reason:'Essential waiting-for-audio state must remain visually available, rather than an irreversible ellipsis');
 });}}
}
