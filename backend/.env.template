ELLA_HERMES_PROVISION_API_TOKEN=
# Separate 32+ byte shared key for the provisioner's honcho-isolation-v2 HMAC.
# It must not equal any server credential (including provision, callback,
# caregiver, ledger, dashboard, voice, operator, Honcho, provider, or dynamic
# Hermes runtime/gateway keys). The backend discovers secret-like environment
# credentials and configured authority references on every verification and
# retains accessor-observed values so a config reload cannot hide cached keys.
ELLA_HERMES_PROVISION_ATTESTATION_KEY=
# Root-only SHA-256 binding of the canonical URL/token pair. Keep both the
# binding and the token in the approved server secret store; never log either.
ELLA_HERMES_PROVISION_AUTHORITY_BINDING_REF=env:ELLA_HERMES_PROVISION_AUTHORITY_BINDING
ELLA_HERMES_PROVISION_AUTHORITY_BINDING=
# Optional comma-separated exact endpoints approved during infra review.
ELLA_HERMES_PROVISION_API_REVIEWED_ALLOWLIST=
ELLA_HERMES_PROVISION_API_TIMEOUT_SECONDS=180
# The provider cap plus this local-work grace and the fixed clock-skew margin
# form one monotonic transaction deadline. It covers response streaming,
# bounded decoding, verification, staging, activation, and publication, and
# must remain strictly below the fixed 360-second attestation lifetime.
ELLA_HERMES_PROVISION_ATTESTATION_VERIFICATION_GRACE_SECONDS=30
ELLA_HERMES_GATEWAY_ALLOWED_HOSTS=
