"""Actual integration/ledger/producer/bridge phases; model/schema review leaves explicit synthetic fixtures."""
import asyncio,copy,sys,unittest,threading,time
from pathlib import Path
import test_preparation_reads as preparation
from test_bridge_readback_split import actual,ROOT,W,definitions
class Tests(unittest.TestCase):
 def setUp(self):
  self.base=preparation.Tests(methodName='test_default_initial_none_keeps_full_context_data_read');self.base.setUp();self.r=self.base.r
  self.cost=0;self.host_budget=None
  def reader(**kwargs):
   def full(runtime,**kw):
    self.base.context_reads+=1
    if self.host_budget is not None:
     limit=self.host_budget.reserve('context_snapshot')
     if self.cost>limit:
      self.r.r.clock+=limit;raise TimeoutError('synthetic_context_transport_deadline')
    self.r.r.clock+=self.cost;return self.r.r.read()
   return full
  self.base.integration_scope['context_reader']=reader
  def requests(*,candidate=None,companion_context,**kwargs):
   common={'policy':'ella-semantic-summary-v1','instructions':'fictional fixture','semantic_contract_version':2,'schema_version':2,'context':copy.deepcopy(companion_context)}
   return common,dict(common,candidate=candidate) if candidate is not None else None
  summary={'title':'Fictional','overview':'Fictional summary','emoji':'x','category':'other'}
  ps={'__name__':__name__,'PublicationBinding':self.base.ProducerBinding,'POLICY':'ella-semantic-summary-v1','ContractError':ValueError,'deepcopy':copy.deepcopy,'generate_requests':requests,'validate_stored_review':lambda **kwargs:summary,'digest':actual.PUB.digest}
  definitions(actual.BACKEND/'ella/services/semantic_contextual_producer_v3.py',{'produce'},ps)
  m=sys.modules['ella.services.semantic_contextual_producer_v3'];m.produce=ps['produce'];m.generate_requests=requests;m.validate_stored_review=lambda **kwargs:summary
  # Match real import wiring: bridge returns the ONE BackendTurn exported by actual ledger.
  self.r.Bridge.__call__.__globals__['BackendTurn']=self.base.ledger_scope['BackendTurn']
 def tearDown(self):self.base.tearDown()
 def run(self,result=None):
  # Keep unittest.TestCase.run contract; synthetic workflow is workflow().
  return super().run(result)
 def workflow(self):
  def update(uid,cid,builder):
   changes,result=builder(self.r.r.reader());self.r.r.doc.update(changes);return {'result':result}
  return asyncio.run(self.base.integration_scope['run_retained_contextual_producer'](uid=self.r.r.uid,conversation_id=self.r.r.cid,repository=None,read_conversation=self.base.reader,update_conversation=update))
 def publish(self,result):
  def context(uid):self.base.context_reads+=1;self.r.r.clock+=self.cost;return self.r.r.read()
  actual.PUB.require_publication(self.r.r.doc,uid=self.r.r.uid,conversation_id=self.r.r.cid,candidate=result['summary'],receipt_id=result['publication_receipt_id'],read_companion_context=context)
 def test_actual_two_roles_ledger_provenance_and_publication_five_then_two_full_reads(self):
  result=self.workflow();self.assertEqual(self.base.context_reads,5);self.assertEqual((self.r.counts['provider'],self.r.counts['write'],self.r.counts['read']),(2,2,2))
  operations=self.r.r.doc['semantic_producer_executions_v1'];self.assertEqual(len(operations),2);self.assertTrue(all(v['status']=='completed' for v in operations.values()))
  self.publish(result);self.assertEqual(self.base.context_reads,7)
 def test_context_mutation_during_readback_blocks_next_role_before_provider(self):
  self.r.during_read=lambda:self.r.r.host.metadata['context-a'].update(canonical_source_sha256='f'*64)
  with self.assertRaises(ValueError):self.workflow()
  self.assertEqual(self.r.counts['provider'],1);self.assertEqual(self.r.counts['write'],1)
 def test_virtual53_contexts_fiveproducer_reads_finish519_but_apply_exceeds600(self):
  self.cost=53;self.r.provider_delay=60;self.r.r.clock=240-2*53
  result=self.workflow();self.assertEqual(self.r.r.clock,519)
  with self.assertRaises(TimeoutError):self.publish(result)
  self.assertEqual(self.r.r.clock,625)
 def test_virtual20_contexts_whole_path460_before_unmodelled_work(self):
  self.cost=20;self.r.provider_delay=60;self.r.r.clock=240-2*20
  result=self.workflow();self.publish(result);self.assertEqual(self.r.r.clock,460)
  self.assertLess(self.r.r.clock,480);self.assertLess(self.r.r.clock,600)
 def test_actual_shared480_host_budget_stops53_cost_scenario_before_receipt(self):
  ns={'__name__':__name__,'threading':threading,'time':time,'CompanionContextUnavailable':ValueError,'remaining_timeout':actual.BUDGET.remaining_timeout}
  definitions(W/'captured-context-v2/candidate/ella/services/semantic_host_context.py',{'HostReadBudget'},ns)
  self.host_budget=ns['HostReadBudget'](clock=lambda:self.r.r.clock)
  self.cost=53;self.r.provider_delay=60;self.r.r.clock=240-2*53
  with self.assertRaises(TimeoutError):self.workflow()
  self.assertEqual(self.r.r.clock,480)
if __name__=='__main__':unittest.main()
