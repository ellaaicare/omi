class HTTPError(Exception):
 def __init__(self,status_code,detail=None,**kwargs):self.status_code,self.detail,self.headers=status_code,detail,kwargs.get('headers',{});super().__init__(str(detail))
def module(name,**values):
 m=types.ModuleType(name);m.__dict__.update(values);return m
def load(name,path):
 spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec);sys.modules[name]=m;spec.loader.exec_module(m);return m
BASE_MODULES={k:module(k,__path__=[]) for k in ['ella','ella.services','models','database']}
with patch.dict(sys.modules,BASE_MODULES):
