   with self.assertRaises(MOD.ContextRecordsRejected):r.deps().records(UID,[OTHER])
  r=ProductionRig();cids=[OTHER,'33333333-3333-4333-8333-333333333333'];docs=[]
  for cid in cids:
   raw=document(cid);raw['transcript_segments']=[{'speaker':'Speaker0','text':'x'*800}];plain=copy.deepcopy(raw);raw['transcript_segments_compressed']=True;raw['transcript_segments']=zlib.compress(json.dumps(raw['transcript_segments']).encode());r.db.data['users/'+UID+'/conversations/'+cid]=raw;docs.append((raw,plain))
  raw_total=sum(len(json.dumps(x,default=str).encode()) for x,_ in docs);decoded=[len(json.dumps(x).encode()) for _,x in docs];cap=max(raw_total,max(decoded))+200;self.assertLess(cap,sum(decoded))
  with patch.dict(sys.modules,r.mods),patch.object(MOD,'MAX_SOURCE_BYTES',cap):
   with self.assertRaises(MOD.ContextRecordsRejected):r.deps().records(UID,cids)


class StrictDecoderTests(unittest.TestCase):
 def test_real_zlib_preserves_negative_floats_exactly(self):
  raw=document();segments=[{'speaker':'Speaker0','text':'synthetic','start':-0.5755119323730469,'end':-2.384185791015625e-07}];raw['transcript_segments_compressed']=True;raw['transcript_segments']=zlib.compress(json.dumps(segments).encode())
  self.assertEqual(MOD.strict_record(raw,UID)['transcript_segments'],segments)
 def test_truncated_trailing_or_oversized_compression_rejects(self):
  valid=zlib.compress(json.dumps([{'text':'synthetic'}]).encode())
  for data in [valid[:-2],valid+b'junk',zlib.compress(json.dumps([{'text':'x'*2000}]).encode())]:
   raw=document();raw.update(transcript_segments_compressed=True,transcript_segments=data)
   with patch.object(MOD,'MAX_SOURCE_BYTES',512):
    with self.assertRaises(MOD.ContextRecordsRejected):MOD.strict_record(raw,UID)
 def test_non_list_or_non_dict_segment_decode_rejects(self):
  for value in ['{}','[1]','null',b'not-json']:
   raw=document();raw['transcript_segments']=value
   with self.assertRaises(MOD.ContextRecordsRejected):MOD.strict_record(raw,UID)



class Response:
 def __init__(self,content,headers=None):self.content,self.headers=content,headers or {}
class Request:
 def __init__(self,body):self.body=body
 async def stream(self):
  for i in range(0,len(self.body),5000):yield self.body[i:i+5000]

def callback_functions():
 path=BACKEND/'utils/ella/exact_firebase_auth.py';tree=ast.parse(path.read_text());names={'_normalize_subject_uid','EllaRequestAuthority','get_exact_service_authority'}
 selected=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name in names]
 scope=module('actual_batch_callback_authority');sys.modules[scope.__name__]=scope;scope.__dict__.update(dataclass=dataclass,secrets=secrets,Optional=Optional,HTTPException=HTTPError,MAX_FIREBASE_UID_LENGTH=128)
 exec(compile(ast.fix_missing_locations(ast.Module(body=ast.parse('from __future__ import annotations').body+selected,type_ignores=[])),str(path),'exec'),scope.__dict__)
 tree=ast.parse(CALLBACK.read_text());nodes=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name in {'require_callback_service','get_context_records_v2'}]
 for n in nodes:n.decorator_list=[]
 scope.__dict__.update(json=json,os=types.SimpleNamespace(getenv=lambda name,default=None:'synthetic-key' if name=='ELLA_CALLBACK_SERVICE_KEY' else default),Header=lambda **kw:None,Depends=lambda value:value,CALLBACK_SERVICE_HEADER='X-Ella-Callback-Service-Key',ELLA_SUBJECT_UID_HEADER='X-Ella-Subject-Uid')
 exec(compile(ast.fix_missing_locations(ast.Module(body=ast.parse('from __future__ import annotations').body+nodes,type_ignores=[])),str(CALLBACK),'exec'),scope.__dict__)
 return scope

class CallbackTests(unittest.IsolatedAsyncioTestCase):
 def setUp(self):self.scope=callback_functions()
 async def route(self,body,*,subject=UID):
  r=ProductionRig();authority=self.scope.require_callback_service(service_key='synthetic-key',subject_uid=subject)
  mods={**r.mods,'database._client':module('database._client',db=r.db),'fastapi':module('fastapi',__path__=[]),'fastapi.responses':module('fastapi.responses',JSONResponse=Response)}
  with patch.dict(sys.modules,mods):result=await self.scope.get_context_records_v2(TARGET,Request(body),service=authority)
  return r,result
 async def test_callback_actual_subject_auth_and_service_pipeline(self):
  r,out=await self.route(json.dumps(arguments()).encode());self.assertEqual(out.headers,{'Cache-Control':'no-store'});self.assertEqual(out.content['owner_sha256'],hashlib.sha256(UID.encode()).hexdigest());self.assertEqual(len(r.db.batch_calls),1)
 async def test_missing_subject_and_wrong_or_unconfigured_key_reject(self):
  for key,subject in [('wrong',UID),('synthetic-key','')]:
   with self.assertRaises(HTTPError) as caught:self.scope.require_callback_service(service_key=key,subject_uid=subject)
   self.assertEqual(caught.exception.status_code,403)
  self.scope.os=types.SimpleNamespace(getenv=lambda name,default=None:'')
  with self.assertRaises(HTTPError) as caught:self.scope.require_callback_service(service_key='synthetic-key',subject_uid=UID)
  self.assertEqual(caught.exception.status_code,503)
 async def test_body_uid_cannot_replace_authenticated_subject(self):
  with self.assertRaises(HTTPError) as caught:await self.route(json.dumps({**arguments(),'uid':'foreign'}).encode())
  self.assertEqual(caught.exception.status_code,409)
 async def test_authenticated_foreign_subject_does_not_read_target_owner(self):
  with self.assertRaises((HTTPError,AssertionError)):
   await self.route(json.dumps(arguments()).encode(),subject='foreign')
 async def test_oversized_body_rejected_before_service(self):
  with self.assertRaises(HTTPError) as caught:await self.route(b'x'*32769)
  self.assertEqual(caught.exception.status_code,413)
 async def test_duplicate_or_nonfinite_json_not_accepted(self):
  for payload in [b'{"conversation_ids":[],"conversation_ids":[]}',b'{"conversation_ids":NaN}']:
   with self.assertRaises(HTTPError) as caught:await self.route(payload)
   self.assertEqual(caught.exception.status_code,503)
 async def test_callback_overlay_is_append_only_and_retains_auth_dependency(self):
  baseline=(ROOT/'baseline/ella/routers/callbacks.py').read_bytes();candidate=CALLBACK.read_bytes();self.assertTrue(candidate.startswith(baseline))
  handler=next(n for n in ast.parse(candidate).body if isinstance(n,ast.AsyncFunctionDef) and n.name=='get_context_records_v2')
  self.assertIn('Depends(require_callback_service)',ast.unparse(handler.args));self.assertIn('service.require_uid(None',ast.unparse(handler))


class BudgetAndParallelTests(unittest.IsolatedAsyncioTestCase):
 async def test_finite_outer_budget_cancels_without_batch_or_reply(self):
  r=DependenciesRig()
  async def slow(uid,cid):await asyncio.sleep(1);return authority_value()
  r.read_authority=slow;original=asyncio.timeout;observed=[]
  def finite(seconds):observed.append(seconds);return original(0.01)
  with patch.object(MOD.asyncio,'timeout',finite):
   with self.assertRaises(TimeoutError):await r.run()
  self.assertEqual(observed,[23]);self.assertEqual(r.calls['records'],0)
 async def test_authority_and_attempt_are_parallel_on_both_sides(self):
  import threading
  r=DependenciesRig();auth_started=[threading.Event(),threading.Event()];attempt_started=[threading.Event(),threading.Event()];counts={'a':0,'b':0}
  async def auth(uid,cid):
   n=counts['a'];counts['a']+=1;auth_started[n].set()
   self.assertTrue(await asyncio.to_thread(attempt_started[n].wait,0.5))
   return authority_value()
  def attempt(uid,cid):
   n=counts['b'];counts['b']+=1;attempt_started[n].set();self.assertTrue(auth_started[n].wait(0.5));return 'b'*64
  d=MOD.Dependencies(auth,attempt,r.records)
  out=await MOD.read_context_records(db=None,uid=UID,target_cid=TARGET,arguments=arguments(),dependencies=d)
  self.assertEqual(counts,{'a':2,'b':2});self.assertEqual(r.calls['records'],1);self.assertEqual(out['attempt_scope_sha256'],'b'*64)

class EnhancedCompressedTests(unittest.TestCase):
 def test_actual_strict_crypto_seam_then_real_zlib_preserves_values(self):
  segments=[{'text':'synthetic','start':-0.5755119323730469,'end':-2.384185791015625e-07}];payload=zlib.compress(json.dumps(segments).encode()).hex();calls=[]
  crypto=types.SimpleNamespace(decrypt_strict=lambda value,uid:(calls.append((value,uid)) or payload));raw=document();raw.update(data_protection_level='enhanced',transcript_segments_compressed=True,transcript_segments='synthetic-compressed-cipher')
  mods={**MODULES,'database.conversations':module('database.conversations',encryption=crypto)}
  with patch.dict(sys.modules,mods):decoded=MOD.strict_record(raw,UID)
  self.assertEqual(decoded['transcript_segments'],segments);self.assertEqual(calls,[('synthetic-compressed-cipher',UID)])


class ConcurrentProductionTests(unittest.IsolatedAsyncioTestCase):
 async def test_unrelated_new_source_does_not_broaden_or_invalidate_batch(self):
  r=ProductionRig()
  def batch(refs):
   rows=[Snapshot(ref,r.db.data.get(ref.path)) for ref in refs];new='unrelated-new-source';r.db.data['users/'+UID+'/conversations/'+new]=document(new);return rows
  r.db.batch_override=batch
  with patch.dict(sys.modules,r.mods):out=await MOD.read_context_records(db=r.db,uid=UID,target_cid=TARGET,arguments=arguments())
  self.assertEqual(set(out['records']),{OTHER});self.assertEqual(len(r.db.batch_calls),1)
 async def test_target_edit_or_delete_between_samples_rejects(self):
  for change in [{'active_summary_version_id':'changed-target-version'},{'transcript_segments':[{'text':'changed-target-source'}]},{'deleted':True}]:
   r=ProductionRig()
   def batch(refs):
    rows=[Snapshot(ref,r.db.data.get(ref.path)) for ref in refs];r.db.data['users/'+UID+'/conversations/'+TARGET].update(change);return rows
   r.db.batch_override=batch
   with patch.dict(sys.modules,r.mods):
    with self.assertRaises(MOD.ContextRecordsRejected):await MOD.read_context_records(db=r.db,uid=UID,target_cid=TARGET,arguments=arguments())
 async def test_account_lineage_change_between_attempt_samples_rejects(self):
  r=ProductionRig()
  def batch(refs):
   rows=[Snapshot(ref,r.db.data.get(ref.path)) for ref in refs];r.job['normal_account_lifecycle_admission']['account_epoch']='changed-account-epoch';return rows
  r.db.batch_override=batch
  with patch.dict(sys.modules,r.mods):
   with self.assertRaises(MOD.ContextRecordsRejected):await MOD.read_context_records(db=r.db,uid=UID,target_cid=TARGET,arguments=arguments())


class ClosedFailurePrivacyTests(unittest.IsolatedAsyncioTestCase):
 async def test_closed_code_set_covers_only_actual_fixed_reject_literals(self):
  tree=ast.parse(SERVICE.read_text());codes={n.args[0].value for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='reject' and n.args and isinstance(n.args[0],ast.Constant) and isinstance(n.args[0].value,str)}
  self.assertEqual(MOD.RECORD_HOLD_CODES,frozenset(codes))
  for code in codes:self.assertEqual(MOD.closed_failure_code(MOD.ContextRecordsRejected(code)),code)
 async def test_unknown_private_or_unhashable_error_is_never_exported(self):
  errors=[MOD.ContextRecordsRejected('private-value-not-in-contract'),MOD.ContextRecordsRejected({'private':'do-not-export'}),MOD.ContextRecordsRejected(['private']),MOD.ContextRecordsRejected('a','private'),ValueError('context_records_target_changed'),RuntimeError('private-value-not-in-contract')]
  for error in errors:
   with self.subTest(kind=type(error).__name__):self.assertEqual(MOD.closed_failure_code(error),'unknown')
 async def test_categorical_known_classes_and_timeout_do_not_echo_args(self):
  for name,expected in [('ContextAuthorityRejected','context_records_authority_changed'),('ProvisioningError','context_records_authority_changed'),('FenceRejected','context_attempt_closed')]:
   error=type(name,(ValueError,),{})('synthetic-private-error');self.assertEqual(MOD.closed_failure_code(error),expected)
  self.assertEqual(MOD.closed_failure_code(TimeoutError('synthetic-private-error')),'context_records_timeout')
 async def test_callback_body_and_header_do_not_echo_private_failures(self):
  scope=callback_functions();authority=scope.require_callback_service(service_key='synthetic-key',subject_uid=UID)
  for error,status,code in [(MOD.ContextRecordsRejected('private-value-not-in-contract'),409,'unknown'),(MOD.ContextRecordsRejected({'private':'do-not-export'}),409,'unknown'),(RuntimeError('private-value-not-in-contract'),503,'unknown'),(TimeoutError('private-value-not-in-contract'),503,'context_records_timeout')]:
   async def rejected(**kwargs):raise error
   mods={**MODULES,'database._client':module('database._client',db=object()),'fastapi':module('fastapi',__path__=[]),'fastapi.responses':module('fastapi.responses',JSONResponse=Response)}
   with patch.dict(sys.modules,mods),patch.object(MOD,'read_context_records',rejected):
    with self.assertRaises(HTTPError) as caught:await scope.get_context_records_v2(TARGET,Request(json.dumps(arguments()).encode()),service=authority)
   self.assertEqual(caught.exception.status_code,status);self.assertEqual(caught.exception.headers,{'X-Ella-Context-Records-Hold-Code':code});self.assertEqual(caught.exception.detail,{'code':'context_records_hold' if status==409 else 'context_records_unavailable'})
   self.assertNotIn('private',json.dumps({'detail':caught.exception.detail,'headers':caught.exception.headers}))

if __name__=='__main__':unittest.main()
