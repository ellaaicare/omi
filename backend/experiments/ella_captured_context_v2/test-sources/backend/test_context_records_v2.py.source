UID='synthetic-owner';TARGET='11111111-1111-4111-8111-111111111111';OTHER='22222222-2222-4222-8222-222222222222';RUNTIME='a'*64

def document(cid=OTHER):
 return {'id':cid,'uid':UID,'status':'completed','discarded':False,'deleted':False,'is_locked':False,'active_summary_version_id':'synthetic-stock','started_at':'2026-10-24T12:00:00+00:00','finished_at':'2026-10-24T12:01:00+00:00','transcript_segments':[{'speaker':'Speaker0','text':'synthetic transcript'}],'structured':{'title':'Synthetic title','overview':'Synthetic overview','category':'other','emoji':'🪽'}}
