 tree=ast.parse((BACKEND/'database/conversations.py').read_text());names={'_prepare_conversation_for_read','_decrypt_conversation_data','_prepare_conversation_for_transcript_hash'}
 selected=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in names]
 scope={'__name__':'actual_protected_read_functions','copy':copy,'json':json,'zlib':zlib,'encryption':Crypto()}
 exec(compile(ast.fix_missing_locations(ast.Module(body=ast.parse('from __future__ import annotations').body+selected,type_ignores=[])),'actual_protected_read_functions.py','exec'),scope)
 return scope

class ProductionRig:
 def __init__(self):
  self.db=DB();self.docs={TARGET:copy.deepcopy(TARGET_DOC),OTHER:document()};self.callback_calls=[];self.prepare_calls=[]
  identity=IDENTITY.build_enrichment_identity(uid=UID,conversation_id=TARGET,conversation=self.docs[TARGET])
  self.job={'uid':UID,'job_id':identity.job_id,'conversation_id':TARGET,'client_interaction_id':identity.client_interaction_id,'transcript_sha256':identity.transcript_sha256,'attempt_count':1,'lease_token':'synthetic-lease','status':'running','dispatch_state':'started_unknown','admission_epoch':'synthetic-policy','normal_account_lifecycle_admission':{'account_epoch':'synthetic-account','route_sha256':'c'*64}}
  attempt=ISOLATION.attempt(self.job);self.job[ISOLATION.FENCE_FIELD]=FENCE.begin(FENCE.reserve(attempt,claims_open=True,previously_quarantined=False),attempt,claims_open=True)
  self.policy={'epoch':'synthetic-policy'};self.db.data['jobs/'+identity.job_id]=self.job
  for cid,doc in self.docs.items():self.db.data['users/'+UID+'/conversations/'+cid]=doc
  helpers=actual_preparers();self.prepare_override=None;self.crypto=Crypto()
  def prepare(raw,uid,strict=False):
   self.prepare_calls.append(uid)
   if self.prepare_override:return self.prepare_override(raw,uid)
   return helpers['_prepare_conversation_for_transcript_hash' if strict else '_prepare_conversation_for_read'](raw,uid)
  def read_conversation(uid,cid):assert uid==UID;return copy.deepcopy(self.docs.get(cid))
  async def read_authority(**kwargs):assert kwargs['uid']==UID and kwargs['conversation_id']==TARGET;return authority_value()
  self.mods={**MODULES,'database.conversations':module('database.conversations',get_conversation=read_conversation,encryption=self.crypto,_prepare_conversation_for_read=lambda raw,uid:prepare(raw,uid),_prepare_conversation_for_transcript_hash=lambda raw,uid:prepare(raw,uid,True)),'database.normal_enrichment_activation':module('database.normal_enrichment_activation',JOBS='jobs',read_policy=lambda db:copy.deepcopy(self.policy)),'database.normal_account_lifecycle':module('database.normal_account_lifecycle',TAG='normal_account_lifecycle_admission',require_callback_source=lambda db,uid,cid,doc:self.callback_calls.append((uid,cid))),'ella.services.semantic_context_authority':module('ella.services.semantic_context_authority',read_context_authority=read_authority),'ella.services.semantic_runtime_authority':module('ella.services.semantic_runtime_authority',resolve_semantic_runtime=lambda *a,**k:None,semantic_runtime_authority_identity=lambda x:x),'ella.services.ai_consent':module('ella.services.ai_consent',assert_current_ai_consent=lambda uid:uid)}
  dbpackage=self.mods['database']
  for n in ['conversations','normal_enrichment_activation','normal_account_lifecycle','enrichment_job_isolation','enrichment_attempt_fence']:setattr(dbpackage,n,self.mods['database.'+n])
 def deps(self):return MOD._production(self.db)

class BatchServiceTests(unittest.IsolatedAsyncioTestCase):
 async def test_exact_seven_key_contract_and_record_pin(self):
  r=DependenciesRig();out=await r.run()
  self.assertEqual(set(out),{'contract','owner_sha256','target_conversation_id','target_source_sha256','runtime_authority_sha256','attempt_scope_sha256','records'});self.assertEqual(set(out['records']),{OTHER});self.assertEqual(out['records'][OTHER]['render_projection_sha256'],MOD.digest(PROJECTION.projection_from_payload(conversation_id=OTHER,payload=CANONICAL.conversation_data_payload(uid=UID,conversation_id=OTHER,conversation=document()))));self.assertEqual(r.calls,{'authority':2,'attempt':2,'records':1})
 async def test_input_limits_reject_before_callbacks(self):
  invalid=[arguments([OTHER,OTHER]),arguments(['bad/child']),arguments(['..']),arguments([str(x) for x in range(81)]),{**arguments(),'uid':'foreign'},{**arguments(),'expected_runtime_authority_sha256':'bad'}]
  for args in invalid:
   r=DependenciesRig()
   with self.subTest(args=args):
    with self.assertRaises(MOD.ContextRecordsRejected):await r.run(args)
    self.assertEqual(sum(r.calls.values()),0)
 async def test_wrong_target_owner_runtime_or_source_rejects(self):
  for mutation in [lambda a:a.update(uid='foreign'),lambda a:a.update(conversation_id=OTHER),lambda a:a.update(source_sha256='d'*64),lambda a:a['runtime_identity'].update(uid='foreign'),lambda a:a['runtime_identity'].update(digest='e'*64)]:
   r=DependenciesRig();mutation(r.authority)
   with self.assertRaises(MOD.ContextRecordsRejected):await r.run()
   self.assertEqual(r.calls['records'],0)
 async def test_mid_read_authority_and_attempt_change_reject(self):
  for change in [lambda r:r.authority.update(runtime={'revision':2}),lambda r:setattr(r,'scope','f'*64)]:
   r=DependenciesRig();r.after_records=change
   with self.assertRaises(MOD.ContextRecordsRejected):await r.run()
 async def test_missing_and_deleted_are_explicit_null_pins(self):
  for doc in [None,{**document(),'deleted':True}]:
   r=DependenciesRig();r.rows[OTHER]=doc;out=await r.run();record=out['records'][OTHER]
   self.assertTrue(record['deleted']);self.assertTrue(all(record[k] is None for k in ['canonical_source_sha256','transcript_sha256','active_summary_version_id','render_projection_sha256']))
 async def test_foreign_or_unavailable_record_rejects(self):
  for changes in [{'uid':'foreign'},{'user_id':'foreign'},{'id':TARGET},{'status':'processing'},{'discarded':True},{'is_locked':True},{'active_summary_version_id':None}]:
   r=DependenciesRig();r.rows[OTHER].update(changes)
   with self.assertRaises(MOD.ContextRecordsRejected):await r.run()
 async def test_version_and_render_mutation_have_distinct_pins(self):
  r=DependenciesRig();before=(await r.run())['records'][OTHER];r.rows[OTHER]['active_summary_version_id']='new-version';version=(await r.run())['records'][OTHER]
  self.assertNotEqual(before['active_summary_version_id'],version['active_summary_version_id']);self.assertEqual(before['canonical_source_sha256'],version['canonical_source_sha256'])
  r.rows[OTHER]['structured']['overview']='different source overview';after=(await r.run())['records'][OTHER];self.assertNotEqual(version['render_projection_sha256'],after['render_projection_sha256']);self.assertNotEqual(version['canonical_source_sha256'],after['canonical_source_sha256'])
 async def test_incomplete_or_extra_batch_map_rejects(self):
  for rows in [{},{OTHER:document(),TARGET:document(TARGET)}]:
   r=DependenciesRig();r.rows=rows
   with self.assertRaises(MOD.ContextRecordsRejected):await r.run()
 async def test_response_capacity_guard(self):
  r=DependenciesRig()
  with patch.object(MOD,'MAX_RESPONSE_BYTES',100):
   with self.assertRaises(MOD.ContextRecordsRejected):await r.run()

