def arguments(cids=None):return {'expected_target_source_sha256':SOURCE,'expected_runtime_authority_sha256':RUNTIME,'conversation_ids':[OTHER] if cids is None else cids}
def authority_value():return {'uid':UID,'conversation_id':TARGET,'source_sha256':SOURCE,'runtime_identity':{'uid':UID,'digest':RUNTIME},'runtime':{'revision':1}}

class DependenciesRig:
 def __init__(self):self.authority=authority_value();self.scope='b'*64;self.rows={OTHER:document()};self.calls={'authority':0,'attempt':0,'records':0};self.after_records=None
 async def read_authority(self,uid,cid):self.calls['authority']+=1;return copy.deepcopy(self.authority)
 def attempt(self,uid,cid):self.calls['attempt']+=1;return self.scope
 def records(self,uid,cids):
  self.calls['records']+=1;result=copy.deepcopy(self.rows)
  if self.after_records:self.after_records(self)
  return result
 async def run(self,args=None):
  d=MOD.Dependencies(self.read_authority,self.attempt,self.records)
  return await MOD.read_context_records(db=None,uid=UID,target_cid=TARGET,arguments=arguments() if args is None else args,dependencies=d)

class Snapshot:
 def __init__(self,ref,value):self.reference,self.id,self.exists=ref,ref.path.split('/')[-1],value is not None;self.value=copy.deepcopy(value)
 def to_dict(self):return copy.deepcopy(self.value)
class Ref:
 def __init__(self,db,path):self.db,self.path=db,str(path)
 def collection(self,name):return Ref(self.db,self.path+'/'+name)
 def document(self,name):return Ref(self.db,self.path+'/'+name)
 def get(self,**kwargs):self.db.get_calls.append((self.path,kwargs));return Snapshot(self,self.db.data.get(self.path))
class DB:
 def __init__(self):self.data={};self.get_calls=[];self.batch_calls=[];self.batch_override=None
 def collection(self,name):return Ref(self,name)
 def get_all(self,refs,**kwargs):
  self.batch_calls.append(([r.path for r in refs],kwargs))
  return self.batch_override(refs) if self.batch_override else [Snapshot(r,self.data.get(r.path)) for r in reversed(refs)]

class Crypto:
 def __init__(self):self.calls=[]
 def decrypt(self,value,uid):return self.decrypt_strict(value,uid)
 def decrypt_strict(self,value,uid):
  self.calls.append(uid)
  if value=='synthetic-valid-cipher':return json.dumps([{'speaker':'Speaker0','text':'synthetic decrypted text'}])
  raise ValueError('synthetic-decode-error')

