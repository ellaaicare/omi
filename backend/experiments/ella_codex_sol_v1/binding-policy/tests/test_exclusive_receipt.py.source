"""Actual controller receipt AST, disposable T3 files only; no DB imports."""
import ast,json,os,stat,tempfile,unittest
from pathlib import Path
F=Path(__file__).resolve().parents[1]
class Tests(unittest.TestCase):
 def setUp(self):
  root=F/'test-temp';root.mkdir(exist_ok=True);self.tmp=tempfile.TemporaryDirectory(dir=root,prefix='receipt-');self.addCleanup(self.tmp.cleanup);self.path=Path(self.tmp.name)/'exclusive.safe.json';tree=ast.parse((F/'control/align_once.py').read_text());cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name=='Receipt');ns={'os':os,'stat':stat,'json':json,'RECEIPT':self.path};exec(compile(ast.Module(body=[cls],type_ignores=[]),'actual_model_binding_receipt','exec'),ns);self.cls=ns['Receipt']
 def test_exclusive_marker_blocks_second_submit(self):
  receipt=self.cls();self.addCleanup(receipt.close);receipt.write({'state':'READY','provider_calls':0});self.assertEqual(stat.S_IMODE(self.path.stat().st_mode),0o600)
  with self.assertRaises(FileExistsError):self.cls()
 def test_preexisting_symlink_never_overwrites_target(self):
  target=self.path.with_name('foreign');target.write_bytes(b'untouched');self.path.symlink_to(target)
  with self.assertRaises(FileExistsError):self.cls()
  self.assertEqual(target.read_bytes(),b'untouched')
 def test_foreign_receipt_inode_never_overwritten(self):
  receipt=self.cls();self.addCleanup(receipt.close);receipt.write({'state':'READY'});foreign=self.path.with_name('foreign');foreign.write_bytes(b'untouched');foreign.chmod(0o600);os.replace(foreign,self.path)
  with self.assertRaises(AssertionError):receipt.write({'state':'must-not-write'})
  self.assertEqual(self.path.read_bytes(),b'untouched')
if __name__=='__main__':unittest.main()
