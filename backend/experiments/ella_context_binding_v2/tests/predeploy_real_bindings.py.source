BODY=''
EXPECTED='1cb305f90e3885657b20f45b4df5dfabbe7794b696572f9db9e7ce9063a81ff8'
class ExpectedContextBoundary(Exception):pass
def run(expect_baseline_red=True):
 assert admission.PublicationBinding is not producer.PublicationBinding
 raw=base64.b64decode(BODY);assert hashlib.sha256(raw).hexdigest()==EXPECTED
 name='ella.services.semantic_producer_ledger_real_type_smoke';spec=importlib.util.spec_from_loader(name,loader=None);module=importlib.util.module_from_spec(spec);sys.modules[name]=module
 exec(compile(raw,name,'exec'),module.__dict__)
 uid='offline-owner';cid='11111111-1111-4111-8111-111111111111'
 doc={'id':cid,'uid':uid,'source':'workflow','status':'completed','started_at':'2026-01-01T00:00:00Z','finished_at':'2026-01-01T00:01:00Z','active_summary_version_id':'offline-stock-v1','structured':{'title':'Fictional','overview':'Fictional only','emoji':'x','category':'other'},'transcript_segments':[{'text':'Fictional only.','speaker':'Speaker 1','is_user':False}],admission.POLICY_FIELD:{'enabled':True,'admissions_open':True,'uid':uid,'conversation_id':cid,'revision':'offline-v2','contextual_schema_version':2,'semantic_contract_version':2,'companion_context_sha256':'c'*64,'companion_context_revision':'offline-r1'}}
 binding=admission.current_binding(doc,uid=uid,conversation_id=cid)
 assert type(binding) is admission.PublicationBinding
 def read(owner,source):assert (owner,source)==(uid,cid);return copy.deepcopy(doc)
 def forbidden(*a,**kw):raise AssertionError('offline_external_effect_forbidden')
 def context(*a,**kw):raise ExpectedContextBoundary()
 job={'job_id':'offline-job','uid':uid,'conversation_id':cid,'attempt_count':1,'lease_token':'offline-lease'}
 async def check(fn):
  with operation_budget_scope(job,600):
   return await fn(uid=uid,conversation_id=cid,read_conversation=read,update_conversation=forbidden,read_companion_context=context,run_backend_turn=forbidden,provider_deadline_seconds=90,role_deadline_seconds=120,candidate_schema_version=2,semantic_contract_version=2,read_source_binding=lambda:admission.current_binding(read(uid,cid),uid=uid,conversation_id=cid))
 old=socket.socket.connect;calls=[]
 def blocked(self,address):calls.append(type(address).__name__);raise AssertionError('offline_network_forbidden')
 socket.socket.connect=blocked
 try:
  try:asyncio.run(check(baseline.run_versioned_producer))
  except admission.SemanticPublicationRejectedError as exc:assert expect_baseline_red and exc.args==('semantic_source_binding_changed',)
  except ExpectedContextBoundary:assert not expect_baseline_red
  else:raise AssertionError('baseline_boundary_not_observed')
  try:asyncio.run(check(module.run_versioned_producer))
  except ExpectedContextBoundary:pass
  else:raise AssertionError('candidate_did_not_reach_expected_boundary')
  assert not calls
  return {'state':('REAL_SERVICE_DISTINCT_BINDING_TYPES_BASELINE_RED_CANDIDATE_PASS_OFFLINE' if expect_baseline_red else 'REAL_SERVICE_DISTINCT_BINDING_TYPES_INSTALLED_AND_CANDIDATE_PASS_OFFLINE'),'python':sys.version.split()[0],'candidate_sha256':EXPECTED,'source_type_module':type(binding).__module__,'producer_type_module':producer.PublicationBinding.__module__,'baseline_rejection':('semantic_source_binding_changed' if expect_baseline_red else None),'candidate_passed_binding_boundary':True,'stopped_before_context_provider_or_DB_write':True,'network_attempts':0,'provider_calls':0,'DB_operations':0,'synthetic_scope_only_not_authority':True}
 finally:socket.socket.connect=old
