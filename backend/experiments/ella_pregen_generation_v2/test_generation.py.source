  with self.assertRaises(ValueError):self.admit()
  self.db.put(('users','u'),{'ai_consent':{'approved':True}});self.proof=self.h.lifecycle.VerifiedRoute('foreign','a'*64,'b'*64,'c'*64)
  with self.assertRaises(ValueError):self.admit()
 def test_source_stock_transcript_deletion_version_drift(self):
  for change in [lambda r:r.update(deleted=True),lambda r:r.update(active_summary_version_id='foreign'),lambda r:r['transcript_segments'][0].update(text='edited'),lambda r:r['summary_versions'][0].update(overview='edited')]:
   raw=copy.deepcopy(self.before[self.key]);change(raw);self.db.put(self.key,raw);self.expected['source']=self.h.lifecycle.digest(raw);self.cert2['predecessor']['source_preimage_sha256']=self.expected['source']
   with self.assertRaises(ValueError):self.admit()
 def test_settlement_or_marker_preimage_drift(self):
