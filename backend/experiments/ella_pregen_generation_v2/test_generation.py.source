   raw=copy.deepcopy(self.before[self.key]);entry=next(iter(raw[self.ns.ROOT][self.oldtag['recovery_id']]['state']['semantic_retained_completion_jobs_v1'].values()));mutate(entry);self.db.put(self.key,raw);self.expected['source']=self.h.lifecycle.digest(raw);self.cert2['predecessor']['source_preimage_sha256']=self.expected['source'];self.cert2['predecessor']['namespace_sha256']=self.h.lifecycle.digest(raw[self.ns.ROOT][self.oldtag['recovery_id']])
   with self.assertRaises(ValueError):self.admit()
 def test_consent_revoked_or_foreign_owner_blocks(self):
