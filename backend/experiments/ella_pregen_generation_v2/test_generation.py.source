  self.parent.update(job_id=identity.job_id,client_interaction_id=identity.client_interaction_id,policy_version=identity.policy_version,trace_id=identity.trace_id)
  prior=self.h.isolation.attempt(dict(self.parent,lease_token=self.parent['operation']['lease_token']));self.parent[self.h.isolation.FENCE_FIELD]=self.h.fence.finish(self.h.fence.begin(self.h.fence.reserve(prior,claims_open=True,previously_quarantined=False),prior,claims_open=True),prior,outcome='unknown_quarantined')
  self.db.put((self.h.activation.JOBS,self.originalid),self.parent);self.db.put(self.h.isolation.tombstone_ref(self.db,self.parent).key,self.tomb)
  self.doc['semantic_retained_completion_jobs_v1']['old-start']['client']=identity.client_interaction_id;self.db.put(self.key,self.doc)
  self.record.update(parent_job_id=self.originalid,job_sha256=self.h.lifecycle.digest(self.parent),original_attempt_sha256=self.ns.digest(self.h.fence._key(prior)),original_semantic_sha256=self.ns.digest({k:self.doc.get(k) for k in self.ns.FIELDS}));self.expected.update(parent_job=self.record['job_sha256'],source=self.h.lifecycle.digest(self.doc))
  result=self.pregen.admit_pregen(self.db.transaction(),self.db,proof=self.proof,parent_job_id=self.originalid,expected=self.expected,reviewed_detachment_sha256='f'*64,protocol_revision=self.pregen.PROTOCOL,now=M.H.h.NOW,reviewed_sync_receipts=self.record['reviewed_sync_receipts']);self.oldid=result['recovery_job_id'];old=self.db.rows[(self.h.activation.JOBS,self.oldid)]
  self.h.issue(old);claimed=self.h.claim(old);self.assertIsNotNone(claimed);self.assertTrue(self.h.begin(claimed))
  old=self.db.rows[(self.h.activation.JOBS,self.oldid)];old['operation']={'lease_token':old['lease_token']};self.db.put((self.h.activation.JOBS,self.oldid),old)
  self.oldtag=old[self.r.TAG];self.oldkey=self.h.fence._key(self.h.isolation.attempt(old))
  # The real prior retained worker persisted START, but no generator/publication existed.
  raw=self.db.rows[self.key];state={'semantic_retained_completion_jobs_v1':{'prior-start':{'status':'started','client':old['client_interaction_id'],'transcript':old['transcript_sha256'],'runtime_binding_id':'synthetic-prior-current-binding','canonical_user':{'confirmed':True},'learning':{'status':'no_learning','reason':'synthetic_disabled'}}}}
  raw[self.ns.ROOT][self.oldtag['recovery_id']]['state']=state;self.db.put(self.key,raw)
  self.assertTrue(self.h.activation.finish(self.db.transaction(),self.db,self.db.collection(self.h.activation.JOBS).document(self.oldid),lease_token=old['lease_token'],now=M.H.h.NOW,outcome='unknown',error_code='synthetic_premodel_guard'))
  self.previous=self.db.rows[(self.h.activation.JOBS,self.oldid)];tref=self.h.isolation.tombstone_ref(self.db,self.previous);self.previoustomb=self.db.rows[tref.key]
  # Separate reviewed settlement fixture: real unchanged cleanup has its own prior tests.
  policy=self.h.activation.read_policy(self.db);policy['queue_unresolved_resources']=[];policy.pop(self.h.activation.SINGLE_CLAIM,None);self.db.put(self.h.activation.reference(self.db).key,policy)
  tenant=self.h.activation.tenant_ref(self.db,'u').get().to_dict();tenant['queue_resource_hold']=None;self.db.put(self.h.activation.tenant_ref(self.db,'u').key,tenant)
  audit={'contract':'ella-queue-v4-migration-v1','action':'settle_resource_only','created_at':M.H.h.NOW,'identity':self.oldkey,'terminal_receipt_sha256':'e'*64,'tombstone_sha256':self.h.lifecycle.digest(self.previoustomb),'job_writes':0}
  self.auditkey=('ella_queue_policy_migrations_v1','settled-'+tref.id);self.db.put(self.auditkey,audit)
  raw=self.db.rows[self.key];head=self.r.source_lock_ref(self.db,self.oldtag).get().to_dict();marker=self.r.marker_ref(self.db,self.oldtag).get().to_dict();operation=self.h.isolation.attempt(dict(self.previous,lease_token=self.previous['operation']['lease_token']))
  pred={'job_id':self.oldid,'identity_sha256':self.ns.digest(self.oldtag),'job_sha256':self.h.lifecycle.digest(self.previous),'tombstone_sha256':self.h.lifecycle.digest(self.previoustomb),'marker_sha256':self.h.lifecycle.digest(marker),'namespace_sha256':self.h.lifecycle.digest(raw[self.ns.ROOT][self.oldtag['recovery_id']]),'head_sha256':self.h.lifecycle.digest(head),'attempt_sha256':self.ns.digest(self.h.fence._key(operation)),'source_preimage_sha256':self.h.lifecycle.digest(raw),'resource_settlement_audit_sha256':self.h.lifecycle.digest(audit),'reviewed_detachment_sha256':'e'*64,'reader_fix_deployment_receipt_sha256':'d'*64}
  self.cert['source_spec_sha256']='a'*64
  self.cert2={'contract':self.gen.PROTOCOL,'source_spec_sha256':'a'*64,'owner_sha256':self.cert['owner_sha256'],'record':copy.deepcopy(self.record),'predecessor':pred};self.gen.certificate=lambda:copy.deepcopy(self.cert2)
  self.expected.update(policy=self.h.lifecycle.digest(policy),tenant=self.h.lifecycle.digest(tenant),source=self.h.lifecycle.digest(raw));self.before=copy.deepcopy(self.db.rows)
 def admit(self,tx=None):return self.gen.admit_generation(tx or self.db.transaction(),self.db,proof=self.proof,parent_job_id=self.originalid,expected=self.expected,reviewed_detachment_sha256='e'*64,protocol_revision=self.gen.PROTOCOL,now=M.H.h.NOW,reviewed_sync_receipts=self.record['reviewed_sync_receipts'])
 def start(self):
  result=self.admit();job=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])];self.h.issue(job);claimed=self.h.claim(job);self.assertIsNotNone(claimed);self.assertTrue(self.h.begin(claimed));return self.db.rows[(self.h.activation.JOBS,job['job_id'])]
 def test_actual_admission_worker_graph_server_callback(self):
  job=self.start();self.assertNotEqual(job['job_id'],self.oldid);self.h.graph.require_in_transaction(self.db.transaction(),self.db,job,'u','c');context=self.r.current_host_context(self.db,'u','c');self.assertEqual(context['job_id'],job['job_id']);self.assertEqual(context['recovery_id'],job[self.r.TAG]['recovery_id'])
  head=self.r.source_lock_ref(self.db,job[self.r.TAG]).get().to_dict();self.assertEqual(head,{'identity':job[self.r.TAG],'job_id':job['job_id']})
  audit=self.db.rows[(self.r.ADMISSIONS,'head-transition-'+job[self.r.TAG]['recovery_id'])];self.assertEqual(audit['previous_head'],{'identity':self.oldtag,'job_id':self.oldid});self.assertEqual(audit['next_head'],head)
  for key in [(self.h.activation.JOBS,self.originalid),(self.h.activation.JOBS,self.oldid),self.h.isolation.tombstone_ref(self.db,self.previous).key,self.r.marker_ref(self.db,self.oldtag).key,self.auditkey]:self.assertEqual(self.db.rows[key],self.before[key])
  raw=self.db.rows[self.key]
  for field in self.ns.FIELDS:self.assertEqual(raw.get(field),self.before[self.key].get(field))
  self.assertEqual(raw[self.ns.ROOT][self.oldtag['recovery_id']],self.before[self.key][self.ns.ROOT][self.oldtag['recovery_id']]);self.assertEqual(raw['summary_versions'],self.before[self.key]['summary_versions']);self.assertEqual(raw['transcript_segments'],self.before[self.key]['transcript_segments'])
 def test_admission_exact_five_document_effect_set(self):
  result=self.admit();newtag=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])][self.r.TAG]
  changed={k for k in set(self.before)|set(self.db.rows) if self.before.get(k)!=self.db.rows.get(k)}
  expected={(self.h.activation.JOBS,newtag['job_id']),self.r.marker_ref(self.db,newtag).key,self.r.source_lock_ref(self.db,newtag).key,(self.r.ADMISSIONS,'head-transition-'+newtag['recovery_id']),self.key}
  self.assertEqual(changed,expected)
  self.assertEqual(set(self.db.rows[self.key][self.ns.ROOT])-set(self.before[self.key][self.ns.ROOT]),{newtag['recovery_id']})
 def test_changed_operation_token_cannot_fake_terminal_predecessor(self):
  job=copy.deepcopy(self.previous);job['operation']['lease_token']='foreign';self.db.put((self.h.activation.JOBS,self.oldid),job);self.cert2['predecessor']['job_sha256']=self.h.lifecycle.digest(job)
  with self.assertRaises(Exception):self.admit()
 def test_actual_production_records_new_generation_attempt(self):
  job=self.start()
  async def unused(*a,**kw):raise AssertionError('unused_runtime_io')
  authority=types.ModuleType('ella.services.semantic_context_authority');authority.read_context_authority_sample=unused
  runtime=types.ModuleType('ella.services.semantic_runtime_authority');runtime.resolve_semantic_runtime=unused;runtime.semantic_runtime_authority_identity=lambda *a:None
  self.consent.assert_current_ai_consent=lambda uid:uid
  with patch.dict(sys.modules,{authority.__name__:authority,runtime.__name__:runtime}):
   V1.load('ella.services.recent_context_projection_v2',W/'captured-context-canonical-projection-v1/candidate/ella/services/recent_context_projection_v2.py')
   records=V1.load('generation_real_context_records',W/'quarantine-recovery-v1/recovery-context-attempt-v1/candidate/ella/services/semantic_context_records_v2.py')
   expected=sys.modules['ella.services.semantic_captured_context'].expected_attempt_digest(job)
   self.assertEqual(records._production(self.db).attempt('u','c'),expected)
   token=sys.modules['database.normal_future_source_disposition']._worker_job.set(job)
   try:self.assertEqual(records._production(self.db).attempt('u','c'),expected)
   finally:sys.modules['database.normal_future_source_disposition']._worker_job.reset(token)
   self.db.put(('users','u'),{'ai_consent':{'approved':False}})
   with self.assertRaises(Exception):records._production(self.db).attempt('u','c')
 def test_old_parent_and_predecessor_callbacks_fail_no_effect(self):
  self.start();before=copy.deepcopy(self.db.rows)
  for job in [self.parent,self.previous]:
   with self.assertRaises(self.h.fence.FenceRejected):self.h.graph.require_in_transaction(self.db.transaction(),self.db,job,'u','c')
  self.assertEqual(self.db.rows,before)
 def test_duplicate_and_unknown_commit_never_rearm(self):
  self.db.commit_unknown=True
  with self.assertRaises(TimeoutError):self.admit()
  self.db.commit_unknown=False;before=copy.deepcopy(self.db.rows)
  with self.assertRaises(ValueError):self.admit()
  self.assertEqual(self.db.rows,before);self.assertEqual(len([v for v in self.db.rows.values() if v.get('contract')==self.gen.AUDIT_CONTRACT]),1)
 def test_concurrent_head_drift_aborts_transaction(self):
  tx=self.db.transaction();commit=tx.commit
  def conflict():self.db.put(self.r.source_lock_ref(self.db,self.oldtag).key,{'identity':self.oldtag,'job_id':'foreign'});commit()
  tx.commit=conflict
  with self.assertRaises(Exception):self.admit(tx)
  self.assertEqual(len([v for v in self.db.rows.values() if v.get('contract')==self.gen.AUDIT_CONTRACT]),0)
 def test_stale_certificate_or_head_rejects_no_writes(self):
  self.cert2['predecessor']['head_sha256']='0'*64
  with self.assertRaisesRegex(ValueError,'generation_head_changed'):self.admit()
  self.assertEqual(self.db.rows,self.before)
 def test_suspicious_prior_effects_even_null_empty_hold(self):
