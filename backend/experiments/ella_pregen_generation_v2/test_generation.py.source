   for value in [None,{}, {'x':{'status':'started'}},{'x':{'status':'completed'}}]:
    raw=copy.deepcopy(self.before[self.key]);raw[self.ns.ROOT][self.oldtag['recovery_id']]['state'][field]=value;self.db.put(self.key,raw);self.expected['source']=self.h.lifecycle.digest(raw);self.cert2['predecessor']['source_preimage_sha256']=self.expected['source'];self.cert2['predecessor']['namespace_sha256']=self.h.lifecycle.digest(raw[self.ns.ROOT][self.oldtag['recovery_id']])
    with self.assertRaises(ValueError):self.admit()
  self.db.rows=copy.deepcopy(self.before)
 def test_started_completed_or_ambiguous_prior_retained_holds(self):
