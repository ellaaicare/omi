   self.db.rows=copy.deepcopy(self.before);value=copy.deepcopy(self.db.rows[key]);value['foreign']='drift';self.db.put(key,value)
   with self.assertRaises(ValueError):self.admit()
 def test_ordinary_claim_independent_of_disabled_generation_certificate(self):
  self.gen.certificate=self.real_certificate;self.h.setUp();a,b,c=self.h.setup_jobs();self.h.issue(a);claimed=self.h.claim(a);self.assertIsNotNone(claimed);self.assertTrue(self.h.begin(claimed));self.h.graph.require_in_transaction(self.h.db.transaction(),self.h.db,claimed,a['uid'],a['conversation_id'])
 def test_existing_v1_helper_and_unaffected_shared_functions_exact(self):
  original=W/'quarantine-recovery-v1/no-completion-successor-v1/rollout-v1/bound-candidate/database/saved_source_recovery.py'
  get=lambda p:{n.name:ast.dump(n,include_attributes=False) for n in ast.parse(p.read_text()).body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
  a,b=get(original),get(B/'candidate/database/saved_source_recovery.py');self.assertEqual({k:v for k,v in a.items() if k not in {'_approved_parent','_stock_fingerprint'}},{k:v for k,v in b.items() if k not in {'_approved_parent','_stock_fingerprint'}})
  self.assertEqual(hashlib.sha256((W/'quarantine-recovery-v1/no-completion-successor-v1/rollout-v1/bound-candidate/database/saved_source_pregen_recovery.py').read_bytes()).hexdigest(),'bc545ebbbd055b3c805a431424b4978d18290f5a8ae49f77f885f83ace5255c3')
 def test_loader_actual_schema_fixed_file_duplicate_and_foreign_reject(self):
  repair=types.ModuleType('database.explicit_saved_backlog_repair');repair.SPEC_SHA256='a'*64
  with tempfile.TemporaryDirectory(dir=B/'evidence') as temporary:
   file=pathlib.Path(temporary)/'saved_source_pregen_generation.expected.json'
   oldfile=self.gen.__file__;oldpin=self.gen.CERTIFICATE_SHA256;self.gen.__file__=str(file.with_name('saved_source_pregen_generation.py'))
   realfstat=os.fstat;reallstat=pathlib.Path.lstat
   def rootmeta(meta):return types.SimpleNamespace(**{k:getattr(meta,k) for k in ['st_dev','st_ino','st_nlink','st_mode','st_size','st_mtime_ns','st_ctime_ns']},st_uid=0,st_gid=0)
   try:
    def check(raw):
     file.write_bytes(raw);file.chmod(0o600);self.gen.CERTIFICATE_SHA256=hashlib.sha256(raw).hexdigest()
     with patch.dict(sys.modules,{repair.__name__:repair}),patch.object(sys.modules['database'],'explicit_saved_backlog_repair',repair,create=True),patch.object(os,'fstat',lambda fd:rootmeta(realfstat(fd))),patch.object(pathlib.Path,'lstat',lambda path:rootmeta(reallstat(path))):return self.real_certificate()
    self.assertEqual(check(json.dumps(self.cert2).encode()),self.cert2)
    for change in [lambda d:d.update(extra=True),lambda d:d['record'].update(stock_version='foreign'),lambda d:d['predecessor'].update(extra=True),lambda d:d['predecessor'].update(job_id='foreign')]:
     value=copy.deepcopy(self.cert2);change(value)
     with self.assertRaises(ValueError):check(json.dumps(value).encode())
    with self.assertRaises(ValueError):check(b'{"contract":"first","contract":"second"}')
    file.unlink();file.symlink_to('missing')
    with self.assertRaises(OSError):self.real_certificate()
   finally:self.gen.__file__=oldfile;self.gen.CERTIFICATE_SHA256=oldpin
 def test_prior_identity_and_current_account_epoch_drift_reject(self):
  self.cert2['predecessor']['identity_sha256']='0'*64
  with self.assertRaises(ValueError):self.admit()
  self.cert2['predecessor']['identity_sha256']=self.ns.digest(self.oldtag);account=self.h.account('u');account['epoch']='foreign';self.db.put(self.h.lifecycle.account_ref(self.db,'u').key,account);self.expected['account']=self.h.lifecycle.digest(account)
  with self.assertRaises(ValueError):self.admit()
 def test_fresh_transaction_retry_after_conflict_creates_one_generation(self):
  tx=self.db.transaction();commit=tx.commit;headkey=self.r.source_lock_ref(self.db,self.oldtag).key;original=copy.deepcopy(self.db.rows[headkey])
  def conflict():self.db.put(headkey,original);commit()
  tx.commit=conflict
  with self.assertRaises(Exception):self.admit(tx)
  # A known aborted transaction may be recomputed; an unknown commit is tested separately.
  result=self.admit();self.assertEqual(len([v for v in self.db.rows.values() if v.get('contract')==self.gen.AUDIT_CONTRACT]),1);self.assertNotEqual(result['recovery_job_id'],self.oldid)
 def test_disabled_loader_fails_before_any_file_access(self):
  self.gen.certificate=self.real_certificate
  with self.assertRaisesRegex(ValueError,'generation_certificate_disabled'):self.admit()
if __name__=='__main__':unittest.main()
