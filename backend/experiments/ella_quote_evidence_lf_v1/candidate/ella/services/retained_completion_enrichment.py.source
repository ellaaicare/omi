"""Narrow retained-owner completion consumer using existing authenticated outbox.

No new credential, allowlist, context copy, main-session memory writer or provider
fallback. Admission is private and transactional. An unknown START never re-arms.
"""
from __future__ import annotations

from ella.services import enrichment_stage_timing as _timing
import asyncio
import copy
import threading
from dataclasses import dataclass
from types import SimpleNamespace

from ella.services import semantic_publication as admission
from ella.services.canonical_summary_source import canonical_source_from_conversation, canonical_source_sha256
from ella.services.runtime_errors import ProvisioningError
from ella.services.semantic_contract_v1 import ContractError
from ella.services.summary_sanitizer import sanitize_summary_update
from ella.services.semantic_companion_context import CompanionContextUnavailable
from models.hermes_cloud_enrichment_contract import build_enrichment_identity, transcript_source
from ella.services.retained_canonical_user import CanonicalUserUnconfirmed
from ella.services.semantic_learning_v3 import LearningHold
from database.normal_future_source_disposition import require_current_runtime
from database.normal_product_capture_provenance import require_initial_source

JOBS_FIELD = 'semantic_retained_completion_jobs_v1'
MAX_JOBS = 8


def reject(code):
    raise admission.SemanticPublicationRejectedError(code)


def owned(doc, uid, cid):
    if not isinstance(doc, dict) or doc.get('id') != cid or doc.get('uid', uid) != uid:
        reject('retained_completion_owned_source_required')
    return doc


def source_pin(doc, uid, cid):
    source = canonical_source_from_conversation(uid=uid, conversation_id=cid, conversation=doc)
    return (canonical_source_sha256(source), str(source.get('finished_at') or source.get('started_at') or ''),
            str(doc.get('active_summary_version_id') or ''))


@dataclass(frozen=True)
class Dependencies:
    selected: object
    resolve: object
    identity: object
    revalidate: object
    consent: object
    hydrate: object
    produce: object
    apply_factory: object
    canonical_user: object = None
    sync_context: object = None
    confirm_canonical_user: object = None
    learning: object = None


from ella.services.transcript_processing_hold import require_transcript_processing_active

class CompletionEnrichmentDispatcher:
    def __init__(self, *, cloud, retained, selected, repository=None):
        self.cloud, self.retained, self.selected = cloud, retained, selected
        self.repository = repository

    async def enrich(self, **kwargs):
        with _timing.operation(kwargs.get('uid'), kwargs.get('conversation_id')):
            await require_transcript_processing_active(kwargs.get('uid'))
            from database._client import db
            from database.normal_account_lifecycle import require_dispatch_context
            require_dispatch_context(kwargs.get('uid'),db)
            # Selected retained failures never spill into another provider.
            if self.repository is not None:
                from ella.services.normal_account_routing import resolve_route
                runtime = await _timing.await_stage('retained_completion_enrichment.await.68', resolve_route(kwargs['uid'], self.repository))
                require_current_runtime(runtime)
                service = self.retained if runtime.provider == 'hermes' else self.cloud
            else:
                service = self.retained if self.selected(kwargs['uid']) else self.cloud
            await require_transcript_processing_active(kwargs.get('uid'))
            return await _timing.await_stage('retained_completion_enrichment.await.72', service.enrich(**kwargs))


class RetainedCompletionEnrichmentService:
    def __init__(self, *, repository, read_conversation, update_conversation, dependencies):
        self.repository, self.read, self.update, self.d = repository, read_conversation, update_conversation, dependencies

    async def enrich(self, *, uid, conversation_id, allow_shadow=False,
                     expected_client_interaction_id=None, expected_transcript_sha256=None):
        try:
            return await _timing.await_stage('retained_completion_enrichment.await.82', self._enrich(uid, conversation_id, allow_shadow, expected_client_interaction_id, expected_transcript_sha256))
        except (admission.SemanticPublicationRejectedError, ContractError, CompanionContextUnavailable, CanonicalUserUnconfirmed,LearningHold) as exc:
            # Fixed internal codes only; no provider/private exception text.
            raise ProvisioningError('retained_completion_rejected', retryable=False) from exc

    async def _enrich(self, uid, cid, shadow, expected_client, expected_hash):
        from ella.services.semantic_captured_context import attempt_context
        with attempt_context(uid, cid):
            return await self._enrich_impl(uid, cid, shadow, expected_client, expected_hash)

    async def _enrich_impl(self, uid, cid, shadow, expected_client, expected_hash):
        with _timing.operation(uid, cid):
            from ella.services.semantic_host_context import HostReadBudget
            host_read_budget=HostReadBudget()
            await require_transcript_processing_active(uid)
            from database._client import db
            from database.normal_account_lifecycle import require_dispatch_context
            require_dispatch_context(uid,db)
            if shadow or not self.d.selected(uid) or not expected_client or not expected_hash:
                reject('retained_completion_exact_queued_owner_required')
            doc = owned(await _timing.await_stage('retained_completion_enrichment.await.93', asyncio.to_thread(self.read, uid, cid)), uid, cid)
            require_initial_source(uid, cid, doc)
            jobs = doc.get(JOBS_FIELD, {})
            if not isinstance(jobs, dict): reject('retained_completion_jobs_invalid')
            key = admission.digest({'uid': uid, 'cid': cid, 'client': expected_client, 'transcript': expected_hash})
            prior = jobs.get(key)
            if prior is not None:
                if (not isinstance(prior, dict) or prior.get('client') != expected_client
                        or prior.get('transcript') != expected_hash): reject('retained_completion_job_conflict')
                if prior.get('status') not in {'proposed', 'completed'}:
                    reject('retained_completion_unknown_start_hold')
                # A durable proposal can reconcile an accepted CAS even after its
                # original active version/policy has changed. APPLY proves replay.
                if transcript_source(doc)[1] != expected_hash: reject('retained_completion_source_changed')
                proposal = copy.deepcopy(prior['proposal'])
                duplicate = True
                runtime_binding_id = prior['runtime_binding_id']
            else:
                if doc.get('status') != 'completed' or not doc.get('active_summary_version_id'):
                    reject('retained_completion_committed_summary_required')
                if admission.POLICY_FIELD in doc or any(doc.get(field) for field in
                        ('semantic_producer_executions_v1', admission.OPERATIONS_FIELD, admission.RECEIPTS_FIELD)):
                    reject('retained_completion_existing_policy_hold')
                queued = build_enrichment_identity(uid=uid, conversation_id=cid, conversation=doc)
                if queued.client_interaction_id != expected_client or queued.transcript_sha256 != expected_hash:
                    reject('retained_completion_queued_source_changed')
                if await _timing.await_stage('retained_completion_enrichment.await.118', asyncio.to_thread(self.d.consent, uid)) != uid:
                    reject('retained_completion_consent_changed')
                runtime = await _timing.await_stage('retained_completion_enrichment.await.120', self.d.resolve(uid, repository=self.repository, target_mode='hermes-cloud-transcript', host_read_budget=host_read_budget))
                require_current_runtime(runtime)
                if runtime is None or runtime.uid != uid or runtime.provider != 'hermes' or runtime.status != 'active':
                    reject('retained_completion_runtime_required')
                identity = self.d.identity(runtime)
                pin = source_pin(doc, uid, cid)
                # Reserve before ANY canonical write or workspace sync. Cancellation,
                # lost responses and unknown STARTs retain the existing no-rearm hold.
                def start(current):
                    owned(current, uid, cid)
                    if source_pin(current, uid, cid) != pin or transcript_source(current)[1] != expected_hash:
                        reject('retained_completion_admission_source_changed')
                    if admission.POLICY_FIELD in current or any(current.get(field) for field in
                            ('semantic_producer_executions_v1', admission.OPERATIONS_FIELD, admission.RECEIPTS_FIELD)):
                        reject('retained_completion_existing_policy_hold')
                    entries = current.get(JOBS_FIELD, {})
                    if not isinstance(entries, dict) or entries:
                        reject('retained_completion_existing_job_hold')
                    return {JOBS_FIELD: {key: {'status': 'started', 'client': expected_client,
                        'transcript': expected_hash, 'runtime_binding_id': runtime.binding_id}}}, {'started': True}
                started = await _timing.await_stage('retained_completion_enrichment.await.139', asyncio.to_thread(self.update, uid, cid, start))
                if started is None or started['result'].get('started') is not True:
                    reject('retained_completion_start_unknown')
                if self.d.canonical_user is None:
                    reject('retained_completion_canonical_user_unconfigured')
                fresh_runtime = await _timing.await_stage('retained_completion_enrichment.await.144', self.d.revalidate(identity, repository=self.repository, host_read_budget=host_read_budget))
                if not self.d.selected(uid) or self.d.identity(fresh_runtime) != identity or await _timing.await_stage('retained_completion_enrichment.await.145', asyncio.to_thread(self.d.consent, uid)) != uid:
                    reject('retained_completion_authority_changed')
                fresh_doc = owned(await _timing.await_stage('retained_completion_enrichment.await.147', asyncio.to_thread(self.read, uid, cid)), uid, cid)
                if source_pin(fresh_doc, uid, cid) != pin:
                    reject('retained_completion_admission_source_changed')
                await require_transcript_processing_active(uid)
                async with asyncio.timeout(15):
                    canonical_user = await _timing.await_stage('retained_completion_enrichment.await.151', self.d.canonical_user(uid=uid, conversation_id=cid, conversation=fresh_doc, expected_client=expected_client, expected_transcript=expected_hash))
                if not isinstance(canonical_user, dict) or canonical_user.get('confirmed') is not True:
                    reject('retained_completion_canonical_user_unconfirmed')
                fresh_runtime = await _timing.await_stage('retained_completion_enrichment.await.155', self.d.revalidate(identity, repository=self.repository, host_read_budget=host_read_budget))
                if not self.d.selected(uid) or self.d.identity(fresh_runtime) != identity or await _timing.await_stage('retained_completion_enrichment.await.156', asyncio.to_thread(self.d.consent, uid)) != uid:
                    reject('retained_completion_authority_changed')
                if source_pin(owned(await _timing.await_stage('retained_completion_enrichment.await.158', asyncio.to_thread(self.read, uid, cid)), uid, cid), uid, cid) != pin:
                    reject('retained_completion_admission_source_changed')
                def save_user(current):
                    owned(current, uid, cid)
                    if source_pin(current, uid, cid) != pin or transcript_source(current)[1] != expected_hash:
                        reject('retained_completion_canonical_source_changed')
                    entries = copy.deepcopy(current.get(JOBS_FIELD, {}))
                    entry = entries.get(key) if isinstance(entries, dict) else None
                    if (not isinstance(entry, dict) or entry.get('status') != 'started'
                            or entry.get('client') != expected_client or entry.get('transcript') != expected_hash):
                        reject('retained_completion_canonical_receipt_conflict')
                    entries[key] = {**entry, 'canonical_user': copy.deepcopy(canonical_user)}
                    return {JOBS_FIELD: entries}, {'confirmed': True}
                saved_user = await _timing.await_stage('retained_completion_enrichment.await.171', asyncio.to_thread(self.update, uid, cid, save_user))
                if saved_user is None or saved_user['result'].get('confirmed') is not True:
                    reject('retained_completion_canonical_receipt_unknown')
                if self.d.sync_context is None:
                    reject('retained_completion_host_sync_unconfigured')
                await require_transcript_processing_active(uid)
                await _timing.await_stage('retained_completion_enrichment.await.176', self.d.sync_context(runtime, uid=uid, conversation_id=cid, runtime_identity=identity, host_read_budget=host_read_budget))
                snapshot = await _timing.await_stage('retained_completion_enrichment.await.177', asyncio.to_thread(self.d.hydrate, runtime, uid=uid, conversation_id=cid, runtime_identity=identity, host_read_budget=host_read_budget))
                await require_transcript_processing_active(uid)
                if self.d.learning is not None:
                    learning_result=await _timing.await_stage('retained_completion_enrichment.await.179', self.d.learning(uid=uid, conversation_id=cid, repository=self.repository, read_conversation=self.read, update_conversation=self.update, canonical_user_receipt=canonical_user, host_read_budget=host_read_budget, selected=self.d.selected))
                    if (not isinstance(learning_result,dict) or learning_result.get('status') not in {'no_learning','learning_applied'}):
                        reject('retained_completion_learning_outcome_required')
                    # Keep a content-free actual result; never promote a summary
                    # receipt into learning authority or discard an evaluated hold.
                    allowed={'status','reason','learning_receipt_id','memory_after_sha256','context_revision'}
                    learning_metadata={k:v for k,v in learning_result.items() if k in allowed}
                    def save_learning(current):
                        owned(current,uid,cid)
                        if source_pin(current,uid,cid)!=pin:reject('retained_completion_learning_source_changed')
                        entries=copy.deepcopy(current.get(JOBS_FIELD) or {});entry=entries.get(key)
                        if not isinstance(entry,dict) or entry.get('status')!='started':reject('retained_completion_learning_start_required')
                        entries[key]={**entry,'learning':learning_metadata}
                        return {JOBS_FIELD:entries},{'saved':True}
                    learning_saved=await _timing.await_stage('retained_completion_enrichment.await.195', asyncio.to_thread(self.update, uid, cid, save_learning))
                    if learning_saved is None or learning_saved['result'].get('saved') is not True:
                        reject('retained_completion_learning_result_unknown')
                    snapshot=await _timing.await_stage('retained_completion_enrichment.await.198', asyncio.to_thread(self.d.hydrate, runtime, uid=uid, conversation_id=cid, runtime_identity=identity, host_read_budget=host_read_budget))
                from ella.services.semantic_captured_context import current_scope, capture_context, policy_fields
                captured_scope = current_scope(uid, cid)
                if captured_scope is not None:
                    snapshot = await asyncio.to_thread(capture_context, runtime=runtime, uid=uid,
                        conversation_id=cid, runtime_identity=identity,
                        read_conversation=self.read, read_budget=host_read_budget)
                context_hash = admission.digest(snapshot)
                from ella.services.semantic_quote_evidence_lf import CONTRACT as EVIDENCE_QUOTE_CONTRACT
                from ella.services.summary_title_quality import fresh_title_revision
                policy = {'enabled': True, 'admissions_open': True, 'uid': uid, 'conversation_id': cid,
                          'contextual_schema_version': 2, 'semantic_contract_version':2,
                          'revision': fresh_title_revision(admission.digest({'job': key, 'source': pin, 'authority': identity.digest,
                                                        'context': context_hash,
                                                        'evidence_quote_contract': EVIDENCE_QUOTE_CONTRACT})),
                          'companion_context_sha256': context_hash, 'companion_context_revision': snapshot['revision'],
                          **policy_fields(uid, cid)}
                loop = asyncio.get_running_loop()
                closed = threading.Event()
                async def authority():
                    if closed.is_set(): reject('retained_completion_admission_cancelled')
                    if not self.d.selected(uid) or await _timing.await_stage('retained_completion_enrichment.await.211', asyncio.to_thread(self.d.consent, uid)) != uid:
                        reject('retained_completion_authority_changed')
                    current = await _timing.await_stage('retained_completion_enrichment.await.213', self.d.revalidate(identity, repository=self.repository, host_read_budget=host_read_budget))
                    if self.d.identity(current) != identity: reject('retained_completion_runtime_changed')
                def reserve(current):
                    if closed.is_set(): reject('retained_completion_admission_cancelled')
                    owned(current, uid, cid)
                    if source_pin(current, uid, cid) != pin or transcript_source(current)[1] != expected_hash:
                        reject('retained_completion_admission_source_changed')
                    future = asyncio.run_coroutine_threadsafe(authority(), loop)
                    try: future.result(timeout=15)
                    except BaseException:
                        future.cancel(); reject('retained_completion_authority_unavailable')
                    fresh = self.d.hydrate(runtime, uid=uid, conversation_id=cid, runtime_identity=identity,host_read_budget=host_read_budget)
                    if admission.digest(fresh) != context_hash:
                        # Closed diagnostics cannot grant authority or replace the rejection.
                        try:
                            import hashlib, json
                            from ella.services.context_snapshot_diagnostics import compare_context_snapshots
                            metadata = compare_context_snapshots(snapshot, fresh)
                            metadata['source_id_sha256'] = hashlib.sha256(cid.encode()).hexdigest()
                            print('ella_context_comparison ' + json.dumps(metadata,sort_keys=True,allow_nan=False),flush=True)
                        except Exception:
                            pass
                        reject('retained_completion_context_changed')
                    existing = current.get(admission.POLICY_FIELD)
                    # Explicit disabled/closed/mismatched policy is never overwritten.
                    if admission.POLICY_FIELD in current and existing != policy:
                        reject('retained_completion_existing_policy_hold')
                    for field in ('semantic_producer_executions_v1', admission.OPERATIONS_FIELD, admission.RECEIPTS_FIELD):
                        if current.get(field): reject('retained_completion_prior_operation_hold')
                    entries = copy.deepcopy(current.get(JOBS_FIELD, {}))
                    if (not isinstance(entries, dict) or set(entries) != {key}
                            or entries[key].get('status') != 'started'):
                        reject('retained_completion_existing_job_hold')
                    entries[key] = {'status': 'started', 'client': expected_client, 'transcript': expected_hash,
                                    'runtime_binding_id': runtime.binding_id, 'canonical_user': canonical_user,
                                    **({'learning':entries[key]['learning']} if 'learning' in entries[key] else {})}
                    # Validate complete private binding before commit.
                    admission.current_binding({**current, admission.POLICY_FIELD: policy}, uid=uid, conversation_id=cid)
                    if closed.is_set(): reject('retained_completion_admission_cancelled')
                    return {admission.POLICY_FIELD: policy, JOBS_FIELD: entries}, {'reserved': True}
                try:
                    committed = await _timing.await_stage('retained_completion_enrichment.await.244', asyncio.to_thread(self.update, uid, cid, reserve))
                except asyncio.CancelledError:
                    closed.set(); raise
                if committed is None or committed['result'].get('reserved') is not True:
                    reject('retained_completion_reservation_unknown')
                if captured_scope is not None:
                    admitted = owned(await asyncio.to_thread(self.read, uid, cid), uid, cid)
                    captured_scope.mark_admitted(admitted)
                await require_transcript_processing_active(uid)
                proposal = await _timing.await_stage('retained_completion_enrichment.await.249', self.d.produce(uid=uid, conversation_id=cid, repository=self.repository, read_conversation=self.read, update_conversation=self.update, host_read_budget=host_read_budget))
                def save(current):
                    owned(current, uid, cid)
                    if source_pin(current, uid, cid) != pin: reject('retained_completion_proposal_source_changed')
                    entries = copy.deepcopy(current.get(JOBS_FIELD, {})); entry = entries.get(key)
                    if not isinstance(entry, dict) or entry.get('status') != 'started':
                        reject('retained_completion_proposal_conflict')
                    receipt = (current.get(admission.RECEIPTS_FIELD) or {}).get(proposal.get('publication_receipt_id'))
                    if not isinstance(receipt, dict) or receipt.get('candidate_sha256') != proposal.get('candidate_sha256'):
                        reject('retained_completion_server_receipt_required')
                    entries[key] = {**entry, 'status': 'proposed', 'proposal': copy.deepcopy(proposal)}
                    return {JOBS_FIELD: entries}, {'saved': True}
                committed = await _timing.await_stage('retained_completion_enrichment.await.262', asyncio.to_thread(self.update, uid, cid, save))
                if committed is None or not committed['result'].get('saved'):
                    reject('retained_completion_proposal_unknown')
                duplicate = False
                runtime_binding_id = runtime.binding_id
            await require_transcript_processing_active(uid)
            apply = self.d.apply_factory(uid=uid, conversation_id=cid, repository=self.repository, read_conversation=self.read,host_read_budget=host_read_budget)
            result = await _timing.await_stage('retained_completion_enrichment.await.268', apply(proposal))
            if not isinstance(result, dict) or result.get('status') != 'completed':
                reject('retained_completion_canonical_pending')
            current = owned(await _timing.await_stage('retained_completion_enrichment.await.271', asyncio.to_thread(self.read, uid, cid)), uid, cid)
            if transcript_source(current)[1] != expected_hash:
                reject('retained_completion_post_apply_source_changed')
            normalized = sanitize_summary_update(**proposal['summary'])
            expected_presentation = {field: getattr(normalized, field) for field in admission.SUMMARY_FIELDS}
            receipt = current.get('summary_writeback_receipt') or {}
            if (receipt.get('status') != 'completed' or receipt.get('canonical_status') != 'completed'
                    or receipt.get('semantic_publication_receipt_id') != proposal['publication_receipt_id']
                    or current.get('active_summary_version_id') != receipt.get('active_summary_version_id')
                    or result.get('operation_receipt', {}).get('token') != receipt.get('token')
                    or admission.candidate_sha256(current.get('structured') or {}) != admission.candidate_sha256(expected_presentation)):
                reject('retained_completion_canonical_readback_required')
            stored = (current.get(admission.RECEIPTS_FIELD) or {}).get(proposal['publication_receipt_id']) or {}
            operations = current.get(admission.OPERATIONS_FIELD) or {}
            generator = operations.get(stored.get('generator_operation_id')) or {}
            verifier = operations.get(stored.get('verifier_operation_id')) or {}
            if (not generator.get('runtime_interaction_id') or not generator.get('canonical_assistant_event_id')
                    or not verifier.get('runtime_interaction_id') or not verifier.get('canonical_assistant_event_id')
                    or generator['runtime_interaction_id'] == verifier['runtime_interaction_id']
                    or generator['canonical_assistant_event_id'] == verifier['canonical_assistant_event_id']):
                reject('retained_completion_actual_provenance_required')
            canonical_user_receipt = current.get(JOBS_FIELD, {}).get(key, {}).get('canonical_user')
            if self.d.confirm_canonical_user is None:
                reject('retained_completion_canonical_user_unconfigured')
            async with asyncio.timeout(15):
                await _timing.await_stage('retained_completion_enrichment.await.296', self.d.confirm_canonical_user(uid=uid, receipt=canonical_user_receipt, expected_transcript=expected_hash))
            return SimpleNamespace(conversation_id=cid, runtime_binding_id=runtime_binding_id,
                runtime_interaction_id=generator['runtime_interaction_id'], active_summary_version_id=current['active_summary_version_id'],
                canonical_user_event_id=(current.get(JOBS_FIELD, {}).get(key, {}).get('canonical_user') or {}).get('event_id'),
                canonical_assistant_event_id=generator['canonical_assistant_event_id'],
                transcript_sha256=expected_hash, summary_sha256=proposal['candidate_sha256'], provider_response_present=True,
                duplicate=duplicate, client_interaction_id=expected_client,
                learning_status=current.get(JOBS_FIELD,{}).get(key,{}).get('learning',{}).get('status','not_requested'),
                learning_receipt_id=current.get(JOBS_FIELD,{}).get(key,{}).get('learning',{}).get('learning_receipt_id'),
                provenance_kind='retained-semantic-operations', verifier_canonical_assistant_event_id=verifier['canonical_assistant_event_id'])


def create_retained_completion_service(*, repository, read_conversation, update_conversation, selected):
    from ella.services.semantic_runtime_authority import resolve_semantic_runtime as resolve_isolated_runtime, semantic_runtime_authority_identity as runtime_authority_identity, revalidate_semantic_runtime as revalidate_runtime_authority
    from ella.services.ai_consent import assert_current_ai_consent
    from ella.services.semantic_host_context import host_context
    from ella.services.semantic_retained_integration import run_retained_contextual_producer
    from ella.services.semantic_retained_apply import create_retained_apply_bridge
    from ella.services.retained_canonical_user import write_retained_canonical_user, confirm_retained_canonical_user
    from ella.routers.canonical_events import PostgresCanonicalEventStore, CanonicalEventIn
    async def canonical_user(**kwargs):
        return await _timing.await_stage('retained_completion_enrichment.await.318', write_retained_canonical_user(**kwargs, event_store=PostgresCanonicalEventStore(), event_type=CanonicalEventIn))
    async def confirm_canonical_user(**kwargs):
        return await _timing.await_stage('retained_completion_enrichment.await.321', confirm_retained_canonical_user(**kwargs, event_store=PostgresCanonicalEventStore()))
    def hydrate(runtime, *, uid, conversation_id, runtime_identity,host_read_budget):
        return host_context(runtime=runtime, uid=uid, conversation_id=conversation_id,
            runtime_identity=runtime_identity, read_conversation=read_conversation,read_budget=host_read_budget)
    async def sync_context(runtime, host_read_budget,**kwargs):
        return await _timing.await_stage('retained_completion_enrichment.await.326', asyncio.to_thread(host_context, runtime=runtime, **kwargs, read_conversation=read_conversation, action='sync', read_budget=host_read_budget))
    from ella.services.semantic_learning_workflow import run_retained_learning
    return RetainedCompletionEnrichmentService(repository=repository, read_conversation=read_conversation,
        update_conversation=update_conversation, dependencies=Dependencies(selected, resolve_isolated_runtime,
        runtime_authority_identity, revalidate_runtime_authority, assert_current_ai_consent,
        hydrate, run_retained_contextual_producer, create_retained_apply_bridge, canonical_user, sync_context,
