"""Actual new admission→existing claim/begin→graph; serialized store and IO leaves.
Source/native decoding and grant predicate are explicit synthetic external leaves.
"""
import ast,copy,hashlib,importlib.util,json,sys,types,unittest
from pathlib import Path
W=Path(__file__).resolve().parents[3];C=W/'quarantine-recovery-v1/integration-v3/candidate';BASE=W/'repo/backend/serving_snapshots/unified-canonical-memory-4235154f/backend'
def load(name,path):
 s=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(s);sys.modules[name]=m;s.loader.exec_module(m);return m
H=load('recovery_single_claim_harness',W/'single-claim-v1/tests/test_single_claim.py')
class Cases(unittest.TestCase):
 @classmethod
 def setUpClass(cls):
  H.SingleClaimTests.setUpClass()
  cls.ns=load('ella.services.semantic_recovery_namespace',C/'ella/services/semantic_recovery_namespace.py')
  # Existing actual modules retain same imports/types; only candidate hooks change.
  for rel,obj in [('database/normal_account_lifecycle.py',H.SingleClaimTests.lifecycle),('database/enrichment_job_isolation.py',H.SingleClaimTests.isolation),('database/enrichment_graph_guard.py',H.SingleClaimTests.graph),('database/normal_enrichment_activation.py',H.SingleClaimTests.activation)]:exec(compile((C/rel).read_text(),str(C/rel),'exec'),obj.__dict__)
  cls.recovery=load('database.saved_source_recovery',C/'database/saved_source_recovery.py');cls.original_approved=cls.recovery.approved_parents
  scope=types.ModuleType('ella.services.semantic_captured_context');tree=ast.parse((C/'ella/services/semantic_captured_context.py').read_text());fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='expected_attempt_digest');exec(compile(ast.Module(body=[fn],type_ignores=[]),'actual_attempt_digest','exec'),scope.__dict__);sys.modules[scope.__name__]=scope
  cls.can=load('ella.services.canonical_summary_source',BASE/'ella/services/canonical_summary_source.py')
  cls.model=load('models.hermes_cloud_enrichment_contract',BASE/'models/hermes_cloud_enrichment_contract.py')
  retained=types.ModuleType('ella.services.retained_completion_enrichment');retained.canonical_source_from_conversation=cls.can.canonical_source_from_conversation;retained.canonical_source_sha256=cls.can.canonical_source_sha256;tree=ast.parse((W/'semantic-correction-loop-v1/candidate/ella/services/retained_completion_enrichment.py').read_text());node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='source_pin');exec(compile(ast.Module(body=[node],type_ignores=[]),'actual_source_pin','exec'),retained.__dict__);sys.modules[retained.__name__]=retained
  # Data decoding is fake plaintext; actual candidate projection is retained.
  cls.olddecode=sys.modules['database.conversations']._prepare_conversation_for_read
  sys.modules['database.conversations']._prepare_conversation_for_read=lambda raw,uid:cls.ns.project_if_recovery(copy.deepcopy(raw),uid)
  cls.consent=types.ModuleType('ella.services.ai_consent');cls.consent._is_current_grant=lambda uid,state,receipt:state=={'approved':True} and receipt is None;sys.modules['ella.services.ai_consent']=cls.consent
 @classmethod
 def tearDownClass(cls):sys.modules['database.conversations']._prepare_conversation_for_read=cls.olddecode;H.SingleClaimTests.tearDownClass()
 def setUp(self):
  self.h=H.SingleClaimTests(methodName='test_single_exact_job_reserved_once_then_begin_closes_atomically');self.h.setUp();h=self.h;h.owner('u');self.db=h.db;self.r=self.recovery
  original_transaction=self.db.transaction
  def transaction(**kwargs):
   tx=original_transaction();original_update=tx.update
   def update(ref,values):
    expanded={}
    for path,value in values.items():
     parts=path.split('.')
     if len(parts)==1:expanded[path]=value;continue
     root=parts[0];expanded.setdefault(root,copy.deepcopy(self.db.rows.get(ref.key,{}).get(root,{})));target=expanded[root]
     for part in parts[1:-1]:target=target.setdefault(part,{})
     target[parts[-1]]=value
    original_update(ref,expanded)
   tx.update=update;return tx
  self.db.transaction=transaction
  self.doc={'uid':'u','id':'c','status':'completed','source':'omi','capture_state':'terminal','normal_source_completed_at':H.h.NOW,'started_at':H.h.NOW,'finished_at':H.h.NOW,'active_summary_version_id':'stock','transcript_segments':[{'text':'Fictional test only.'}],'structured':{'title':'Stock','overview':'Original stock summary','emoji':'x','category':'other'},'summary_versions':[{'id':'stock','is_active':True,'source':'omi','kind':'generated','title':'Stock','overview':'Original stock summary','emoji':'x','category':'other'}]}
  source=self.can.canonical_source_from_conversation(uid='u',conversation_id='c',conversation=self.doc);ts=self.model.transcript_source(self.doc)[1]
  self.parent={'job_id':'parent-Q','uid':'u','conversation_id':'c','client_interaction_id':'client','transcript_sha256':ts,'status':'quarantined','dispatch_state':'unknown_quarantined','attempt_count':1,'source_completed_at':H.h.NOW,'policy_version':'normal'}
  b={'uid':'u','conversation_id':'c','source_sha256':self.can.canonical_source_sha256(source),'source_version':str(source['finished_at']),'transcript_sha256':ts,'active_summary_version_id':'stock'}
  self.doc['semantic_producer_executions_v1']={'oldop':{'status':'completed','result':{'old':'immutable'},'binding':b,'runtime_interaction_id':'old-event','canonical_assistant_event_id':'old-assistant'}}
  self.doc['semantic_publication_policy']={'old':'immutable'}
  self.db.put((h.activation.JOBS,'parent-Q'),self.parent);self.tomb={'old':'immutable'};self.db.put(h.isolation.tombstone_ref(self.db,self.parent).key,self.tomb)
  self.key=('users','u','conversations','c');self.db.put(self.key,self.doc);self.db.put(('users','u'),{'ai_consent':{'approved':True}})
  policy=self.db.rows[h.activation.reference(self.db).key];policy['queue_isolation']['claims_open']=False;self.db.put(h.activation.reference(self.db).key,policy)
  account=h.account('u');self.proof=h.lifecycle.VerifiedRoute('u',account['route_sha256'],account['account_owner_sha256'],account['profile_sha256'])
  synthetic_parents={'parent-Q':{'cid':'c','job_sha256':h.lifecycle.digest(self.parent),'source_created_at':str(self.db.collection('users').document('u').collection('conversations').document('c').get().create_time)}};self.r.approved_parents=lambda:copy.deepcopy(synthetic_parents)
  self.expected={'policy':h.lifecycle.digest(policy),'account':h.lifecycle.digest(account),'tenant':h.lifecycle.digest(h.activation.tenant_ref(self.db,'u').get().to_dict()),'source':h.lifecycle.digest(self.doc),'parent_job':h.lifecycle.digest(self.parent),'parent_tombstone':h.lifecycle.digest(self.tomb),'stock_content':self.ns.digest({k:v for k,v in self.doc['summary_versions'][0].items() if k!='is_active'})}
 def admit(self):return self.r.admit(self.db.transaction(),self.db,proof=self.proof,parent_job_id='parent-Q',expected=self.expected,reviewed_detachment_sha256='f'*64,protocol_revision='reviewed-v1',now=H.h.NOW,reviewed_sync_receipts={'sync_start_receipt_sha256':'a'*64,'sync_completed_receipt_sha256':'b'*64})
 def test_admission_claim_begin_graph_actual_composition(self):
  before=copy.deepcopy(self.db.rows);result=self.admit();job=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])];self.assertEqual(self.db.rows[(self.h.activation.JOBS,'parent-Q')],self.parent)
  self.h.issue(job);claimed=self.h.claim(job);self.assertIsNotNone(claimed);self.assertTrue(self.h.begin(claimed));current=self.db.rows[(self.h.activation.JOBS,job['job_id'])]
  self.h.graph.require_in_transaction(self.db.transaction(),self.db,current,'u','c')
  for k in self.ns.FIELDS:self.assertEqual(self.db.rows[self.key].get(k),before[self.key].get(k))
 def test_old_closed_parent_graph_rejected_during_recovery(self):
  result=self.admit();job=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])];self.h.issue(job);claimed=self.h.claim(job);self.assertTrue(self.h.begin(claimed));before=copy.deepcopy(self.db.rows)
  with self.assertRaises(self.h.fence.FenceRejected):self.h.graph.require_in_transaction(self.db.transaction(),self.db,self.parent,'u','c')
  self.assertEqual(self.db.rows,before)
 def test_other_protocol_revision_cannot_create_parallel_recovery(self):
  self.admit();self.expected['source']=self.h.lifecycle.digest(self.db.rows[self.key]);before=copy.deepcopy(self.db.rows)
  with self.assertRaisesRegex(ValueError,'source_recovery_already_exists'):self.r.admit(self.db.transaction(),self.db,proof=self.proof,parent_job_id='parent-Q',expected=self.expected,reviewed_detachment_sha256='f'*64,protocol_revision='another-review',now=H.h.NOW,reviewed_sync_receipts={'sync_start_receipt_sha256':'a'*64,'sync_completed_receipt_sha256':'b'*64})
  self.assertEqual(self.db.rows,before)
 def test_other_account_active_does_not_block_metadata_admission(self):
  p=self.h.activation.read_policy(self.db);p['active']=[{'uid':'other-account','job_id':'other-job','lease_token':'other-lease'}];self.db.put(self.h.activation.reference(self.db).key,p);self.expected['policy']=self.h.lifecycle.digest(p);self.admit();self.assertEqual(self.h.activation.read_policy(self.db)['active'],p['active'])
 def test_revocation_after_begin_rejects_real_graph(self):
  result=self.admit();job=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])];self.h.issue(job);claimed=self.h.claim(job);self.assertTrue(self.h.begin(claimed));current=self.db.rows[(self.h.activation.JOBS,job['job_id'])];self.db.put(('users','u'),{'ai_consent':{'approved':False}})
  with self.assertRaises(self.h.fence.FenceRejected):self.h.graph.require_in_transaction(self.db.transaction(),self.db,current,'u','c')
 def test_preflight_is_held_without_ordinary_marker_rearm(self):
  result=self.admit();job=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])];self.h.issue(job);claimed=self.h.claim(job)
  ok=self.h.activation.finish(self.db.transaction(),self.db,self.db.collection(self.h.activation.JOBS).document(job['job_id']),lease_token=claimed['lease_token'],now=H.h.NOW,outcome='preflight',error_code='account_runtime_not_ready')
  self.assertTrue(ok);current=self.db.rows[(self.h.activation.JOBS,job['job_id'])];self.assertEqual(current['status'],'blocked');self.assertEqual(current['dispatch_state'],'verified_no_dispatch');self.assertIsNone(self.h.claim(current));self.assertEqual(self.db.rows[(self.h.activation.JOBS,'parent-Q')],self.parent)
 def test_recreated_identical_source_rejected(self):
  self.db.created[self.key]=H.h.NOW
  with self.assertRaisesRegex(ValueError,'source_recreated'):self.admit()
 def test_prior_learning_even_null_requires_review(self):
  self.doc['semantic_learning_policy_v3']=None;self.db.put(self.key,self.doc);self.expected['source']=self.h.lifecycle.digest(self.doc)
  with self.assertRaisesRegex(ValueError,'prior_learning'):self.admit()
 def test_missing_or_malformed_private_config_does_not_block_ordinary(self):
  import tempfile
  oldfile=self.r.__file__;self.r.approved_parents=self.original_approved
  try:
   with tempfile.TemporaryDirectory(dir=C.parent) as td:
    self.r.__file__=str(Path(td)/'saved_source_recovery.py')
    for content in [None,b'invalid-private-config']:
     if content is not None:(Path(td)/'saved_source_recovery.expected.json').write_bytes(content)
     self.h.setUp();a,b,c=self.h.setup_jobs();self.h.issue(a);claimed=self.h.claim(a);self.assertIsNotNone(claimed);self.assertTrue(self.h.begin(claimed));self.h.graph.require_in_transaction(self.h.db.transaction(),self.h.db,claimed,a['uid'],a['conversation_id'])
  finally:self.r.__file__=oldfile
 def test_foreign_owner_rejects_admission(self):
  self.proof=self.h.lifecycle.VerifiedRoute('foreign','a'*64,'b'*64,'c'*64)
  with self.assertRaises(ValueError):self.admit()
 def test_unknown_operation_no_admission(self):
  self.doc['semantic_producer_executions_v1']['oldop']['status']='started';self.db.put(self.key,self.doc);self.expected['source']=self.h.lifecycle.digest(self.doc)
  with self.assertRaisesRegex(ValueError,'parent_unknown'):self.admit()
 def test_duplicate_does_not_rearm(self):
  self.admit()
  with self.assertRaises(ValueError):self.admit()
 def test_revoked_consent_no_admission(self):
  self.db.put(('users','u'),{'ai_consent':{'approved':False}})
  with self.assertRaisesRegex(ValueError,'current_consent'):self.admit()
 def start_recovery(self):
  result=self.admit();job=self.db.rows[(self.h.activation.JOBS,result['recovery_job_id'])];self.h.issue(job);claimed=self.h.claim(job);self.assertTrue(self.h.begin(claimed));return self.db.rows[(self.h.activation.JOBS,job['job_id'])]
 def test_server_callback_without_worker_ContextVar_gets_exact_current_graph(self):
  job=self.start_recovery()
  scope=types.ModuleType('ella.services.semantic_captured_context');tree=ast.parse((C/'ella/services/semantic_captured_context.py').read_text());fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='expected_attempt_digest');exec(compile(ast.Module(body=[fn],type_ignores=[]),'actual_attempt_digest','exec'),scope.__dict__);sys.modules[scope.__name__]=scope
  value=self.r.current_host_context(self.db,'u','c');self.assertEqual(value['job_id'],job['job_id']);self.assertEqual(value['attempt_scope_sha256'],scope.expected_attempt_digest(job));self.assertEqual(value['sync_start_receipt_sha256'],'a'*64)
  self.assertEqual(self.db.rows[(self.h.activation.JOBS,'parent-Q')],self.parent)
 def test_actual_lifecycle_callback_selects_current_server_recovery(self):
  job=self.start_recovery();value=self.h.lifecycle.require_callback_source(self.db,'u','c',self.doc,now=H.h.NOW);self.assertEqual(value['job_id'],job['job_id']);self.assertEqual(value['source_sha256'],self.can.canonical_source_sha256(self.can.canonical_source_from_conversation(uid='u',conversation_id='c',conversation=self.doc)))
 def test_server_callback_stale_attempt_closed_rejects(self):
  job=self.start_recovery();job['lease_token']='foreign';self.db.put((self.h.activation.JOBS,job['job_id']),job)
  with self.assertRaises(Exception):self.r.current_host_context(self.db,'u','c')
 def test_server_callback_current_revocation_rejects(self):
  self.start_recovery();self.db.put(('users','u'),{'ai_consent':{'approved':False}})
  with self.assertRaises(Exception):self.r.current_host_context(self.db,'u','c')
 def test_server_callback_changed_source_rejects(self):
  self.start_recovery();doc=self.db.rows[self.key];doc['transcript_segments'][0]['text']='edited';self.db.put(self.key,doc)
  with self.assertRaises(Exception):self.r.current_host_context(self.db,'u','c')
 def test_server_callback_foreign_target_no_descriptor(self):
  self.start_recovery();self.assertIsNone(self.r.current_host_context(self.db,'u','foreign-cid'))
 def test_missing_exact_sync_proof_refuses_admission(self):
  with self.assertRaisesRegex(ValueError,'reviewed_completed_sync_required'):self.r.admit(self.db.transaction(),self.db,proof=self.proof,parent_job_id='parent-Q',expected=self.expected,reviewed_detachment_sha256='f'*64,protocol_revision='reviewed-v1',now=H.h.NOW)
if __name__=='__main__':unittest.main()
