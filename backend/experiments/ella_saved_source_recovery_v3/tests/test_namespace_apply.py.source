   result=asyncio.run(service._enrich(r.uid,r.cid,False,queued.client_interaction_id,queued.transcript_sha256))
   self.assertNotEqual(result.active_summary_version_id,'stock');self.assertEqual(f.db.rows[f.key]['summary_writeback_receipt']['canonical_status'],'completed');self.assertEqual(host.images(),before);self.assertEqual(host.sync_calls,0);self.check_old();self.assertEqual(len(f.canonical),1)
