 def test_late_parent_callback_after_completed_does_not_duplicate(self):
  proposal=self.produce();self.apply(proposal);before=copy.deepcopy(self.f.db.rows[self.f.key]);calls=len(self.f.canonical);old={**self.r.job,'job_id':'original-closed-Q','lease_token':'closed-parent-lease'};old.pop('saved_source_recovery_admission');old['normal_account_lifecycle_admission']={'account_epoch':'account-epoch','route_sha256':'a'*64};token=self.parent.app.R.future._worker_job.set(old)
