   self.assertEqual(len(p.calls),0)
   return await asyncio.to_thread(hostmod.host_context,runtime=r.runtime,uid=r.uid,conversation_id=r.cid,runtime_identity=r.identity,read_conversation=self.read,action='sync',read_budget=kw['host_read_budget'],client_factory=Client,authority_reader=lambda **kw:fixture_authority)
