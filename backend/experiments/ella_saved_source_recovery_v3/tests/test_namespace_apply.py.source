   with self.assertRaises(type(error)):asyncio.run(ns['worker_context'](effect)(None,{'uid':'synthetic','saved_source_recovery_admission':{'not-authority':'context-only'}}))
   self.assertEqual(self.parent.app.R.future._worker_job.get(),original);self.assertIsNone(self.ns.current_job(self.r.uid,self.r.cid))
