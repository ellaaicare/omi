class OrdinaryIndependence(unittest.TestCase):
 def setUp(self):
  self.parent=H.CapturedApply(methodName='test_captured_v2_correction_actual_issuer_then_actual_apply');self.parent.setUp();self.f=self.parent.f;self.r=self.f.r
  self.ns=load('ella.services.semantic_recovery_namespace',C/'ella/services/semantic_recovery_namespace.py')
  # Full new module import remains lazy, with declared legacy service import leaves.
  activation=types.ModuleType('database.normal_enrichment_activation');sys.modules[activation.__name__]=activation
  recovery=load('database.saved_source_recovery',C/'database/saved_source_recovery.py');recovery.__file__=str(C/'private_DOES_NOT_EXIST'/'saved_source_recovery.py');self.recovery=recovery
  self.f.dbm._prepare_conversation_for_read=lambda value,uid:self.ns.project_if_recovery(copy.deepcopy(value),uid)
