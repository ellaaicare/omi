 def test_worker_context_reset_after_recovery_error_and_cancel(self):
  from functools import wraps
  source=ast.parse((C/'database/normal_future_source_disposition.py').read_text());fn=next(n for n in source.body if isinstance(n,ast.FunctionDef) and n.name=='worker_context');ns={'TAG':'trusted_future_source_admission','wraps':wraps,'copy':copy,'_worker_job':self.parent.app.R.future._worker_job};exec(compile(ast.Module(body=[fn],type_ignores=[]),'actual_worker_context','exec'),ns)
  original=self.parent.app.R.future._worker_job.get()
