 def tearDown(self):self.parent.tearDown()
 def produce(self,retain=True):
  r=self.r;p=self.parent;f=self.f
  def adapter(role,request):
   f.io();r.scope.check();r.read();p.calls.append((role,copy.deepcopy(request)));p.obs[(role,p.pub.digest(request))]=('interaction-'+str(len(p.calls)),'event-'+str(len(p.calls)))
   return copy.deepcopy((p.bad if len(p.calls)==1 else p.good) if role=='generator' else p.verdict)
  proposal=p.v3.produce(**p.args,current_binding=lambda:p.original.PublicationBinding(**p.pub.current_binding(self.read(r.uid,r.cid),uid=r.uid,conversation_id=r.cid).__dict__),ledger=p.ledger,generator_adapter=lambda request:adapter('generator',request),verifier_adapter=lambda request:adapter('verifier',request))
  def retained_builder(current):return {p.pub and 'semantic_retained_completion_jobs_v1':{p.pub.digest({'uid':r.uid,'cid':r.cid,'client':r.job['client_interaction_id'],'transcript':self.tag['transcript_sha256']}):{'status':'proposed','client':r.job['client_interaction_id'],'transcript':self.tag['transcript_sha256'],'proposal':proposal}}},{}
  if retain:f.dbm.update_conversation_with_builder(r.uid,r.cid,retained_builder)
  return proposal
 def apply(self,proposal):
  bridge=self.f.apply.RetainedSemanticApply(uid=self.r.uid,conversation_id=self.r.cid,repository=None,read_conversation=self.read,dependencies=self.f.deps)
  return asyncio.run(bridge(proposal))
 def check_old(self):
  for k,v in self.original_maps.items():self.assertEqual(self.f.db.rows[self.f.key].get(k),v)
 def test_full_captured_producer_namespace_APPLY_and_exact_replay(self):
  proposal=self.produce();result=self.apply(proposal);self.assertEqual(result['status'],'completed');self.check_old();current=self.f.db.rows[self.f.key];self.assertEqual(current['summary_writeback_receipt']['status'],'completed');self.assertNotEqual(current['active_summary_version_id'],'stock');version=current['active_summary_version_id'];self.assertEqual(len(self.f.canonical),1)
  self.apply(proposal);self.assertEqual(self.f.db.rows[self.f.key]['active_summary_version_id'],version);self.assertEqual(len(self.f.canonical),1);self.check_old()
 def test_new_attempt_lease_change_stops_before_APPLY(self):
  proposal=self.produce();self.r.job['lease_token']='stale'
  with self.assertRaises(Exception):self.apply(proposal)
  self.assertNotIn('summary_writeback_receipt',self.f.db.rows[self.f.key]);self.check_old()
 def test_pending_accepted_race_reconciles_same_namespace_once(self):
