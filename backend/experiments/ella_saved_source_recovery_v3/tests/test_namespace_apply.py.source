  result=self.apply(proposal);self.assertEqual(result['status'],'completed');self.assertEqual(self.f.db.rows[self.f.key]['summary_versions'],pending['summary_versions']);self.assertEqual(len(self.f.canonical),1);self.check_old()
 def test_completed_accepted_race_does_not_duplicate(self):
  proposal=self.produce();before=copy.deepcopy(self.f.db.rows[self.f.key]);self.apply(proposal);completed=copy.deepcopy(self.f.db.rows[self.f.key]);self.f.db.put(self.f.key,before);self.f.canonical.clear();self.f.db.before_commit=lambda db:db.put(self.f.key,completed)
  self.apply(proposal);self.assertEqual(self.f.db.rows[self.f.key]['summary_versions'],completed['summary_versions']);self.assertEqual(self.f.canonical,[]);self.check_old()
 def test_late_parent_callback_before_CAS_has_no_effect(self):
