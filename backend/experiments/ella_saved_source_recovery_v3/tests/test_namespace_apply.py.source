  async def produce(**kw):
   r.scope=R.SCOPE.current_scope(r.uid,r.cid);r.doc=self.read(r.uid,r.cid)
   p.args['binding']=p.original.PublicationBinding(**p.pub.current_binding(r.doc,uid=r.uid,conversation_id=r.cid).__dict__)
   p.args['companion_context']=r.scope.envelope()['snapshot'];p.args['canonical_source']=source
