"""Reuse frozen actual APPLY/SDK/namespace harness with pregen original maps.
Admission/worker graph is tested separately by test_pregen_successor. External
storage/crypto/graph leaves remain explicit doubles; this is no live proof.
"""
import pathlib,types,sys,unittest,hashlib
W=pathlib.Path(__file__).resolve().parents[3]
SOURCE=W/'quarantine-recovery-v1/integration-v3/tests/test_namespace_apply.py'
text=SOURCE.read_text()
old="raw=copy.deepcopy(oldvirtual);raw['semantic_publication_policy']={'old':'immutable'};raw['semantic_producer_executions_v1']={'old-Q':{'status':'started','result':'immutable'}}"
new="raw=copy.deepcopy(oldvirtual)\n  for key in ns.FIELDS:raw.pop(key,None)\n  raw['semantic_retained_completion_jobs_v1']={'old-pregen':{'status':'started','client':r.job['client_interaction_id'],'transcript':r.job['transcript_sha256'],'runtime_binding_id':'synthetic-closed-parent','canonical_user':{'confirmed':True},'learning':{'status':'no_learning','reason':'synthetic_disabled'}}}"
assert text.count(old)==1 and text.count("protocol_revision='recovery-v1'")==1
text=text.replace(old,new).replace("protocol_revision='recovery-v1'","protocol_revision='ella-terminal-pregen-successor-v1'")
module=types.ModuleType('pregen_actual_apply_fixture');module.__file__=str(SOURCE);sys.modules[module.__name__]=module
exec(compile(text,str(SOURCE),'exec'),module.__dict__)
NAMES=['test_full_captured_producer_namespace_APPLY_and_exact_replay','test_current_recovery_readback_uses_exact_accepted_namespace','test_pending_accepted_race_reconciles_same_namespace_once','test_completed_accepted_race_does_not_duplicate','test_late_parent_callback_before_CAS_has_no_effect','test_late_parent_callback_after_completed_does_not_duplicate','test_consent_revoke_inside_APPLY_prevents_new_write','test_new_attempt_lease_change_stops_before_APPLY']
def load_tests(loader,tests,pattern):return unittest.TestSuite(module.Cases(name) for name in NAMES)
if __name__=='__main__':unittest.main()
