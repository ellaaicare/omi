 def test_existing_completed_admission_remains_distinct(self):
  source=self.can.canonical_source_from_conversation(uid='u',conversation_id='c',conversation=self.doc)
  doc=copy.deepcopy(self.doc);doc.pop('semantic_retained_completion_jobs_v1');doc['semantic_producer_executions_v1']={'completed':{'status':'completed','result':{'synthetic':'immutable'},'runtime_interaction_id':'event','canonical_assistant_event_id':'assistant','binding':{'uid':'u','conversation_id':'c','source_sha256':self.can.canonical_source_sha256(source),'source_version':str(source['finished_at']),'transcript_sha256':self.parent['transcript_sha256'],'active_summary_version_id':'stock'}}}
  self.db.put(self.key,doc);self.expected['source']=self.h.lifecycle.digest(doc)
  self.r.approved_parents=lambda:{'parent-Q':{'cid':'c','job_sha256':self.record['job_sha256'],'source_created_at':self.record['source_created_at']}}
  self.pregen.certificate=self.original_certificate
  self.expected['stock_content']=self.ns.digest({k:v for k,v in self.doc['summary_versions'][0].items() if k!='is_active'})
  result=self.r.admit(self.db.transaction(),self.db,proof=self.proof,parent_job_id='parent-Q',expected=self.expected,reviewed_detachment_sha256='f'*64,protocol_revision='existing-completed-protocol',now=M.H.h.NOW,reviewed_sync_receipts=self.record['reviewed_sync_receipts'])
  self.assertTrue(result['parent_preserved'])
 def test_unchanged_resource_settlement_once_then_repeat_rejects(self):
  self.h.setUp();h=self.h;account=h.owner('one');candidate=h.job('one');policy=h.activation.read_policy(h.db);policy['queue_isolation']['claims_open']=False;h.db.put(h.activation.reference(h.db).key,policy);h.issue(candidate);job=h.claim(candidate);self.assertTrue(h.begin(job));h.finish(job)
  tomb=h.isolation.tombstone_ref(h.db,job).get().to_dict();tenant=h.activation.tenant_ref(h.db,'one').get().to_dict();current=h.db.rows[(h.activation.JOBS,job['job_id'])]
  # Execute EXACT unchanged reviewed helper source on genuine existing harness.
  source=W/'control/queue_policy_transition.py';self.assertEqual(hashlib.sha256(source.read_bytes()).hexdigest(),'da515ebefebf1dd9d220a8f2e40b8be0e3eacfcc6611cb797f59698ebf023101')
  exec(compile(source.read_text(),str(source),'exec'),h.transition.__dict__)
  proof=h.transition.ReviewedResourceSettlement(h.lifecycle.VerifiedRoute('one',account['route_sha256'],account['account_owner_sha256'],account['profile_sha256']),job['job_id'],h.lifecycle.digest(tomb),h.lifecycle.digest(tenant),'f'*64,h.lifecycle.digest(account),h.lifecycle.digest(current))
  before=copy.deepcopy(current);result=h.transition.settle_resource(h.db.transaction(),h.db,proof=proof,expected_policy_sha256=h.lifecycle.digest(h.activation.read_policy(h.db)),now=M.H.h.NOW)
  self.assertEqual(result['job_writes'],0);self.assertEqual(h.db.rows[(h.activation.JOBS,job['job_id'])],before);after=copy.deepcopy(h.db.rows)
  with self.assertRaises(Exception):h.transition.settle_resource(h.db.transaction(),h.db,proof=proof,expected_policy_sha256=h.lifecycle.digest(h.activation.read_policy(h.db)),now=M.H.h.NOW)
  self.assertEqual(h.db.rows,after)
 def timestamp_stock(self):
  self.doc['summary_versions'][0]['created_at']=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456000Z')
  self.db.put(self.key,self.doc);self.expected['source']=self.h.lifecycle.digest(self.doc)
  value={k:v for k,v in self.doc['summary_versions'][0].items() if k!='is_active'};self.record['stock_content_sha256']=self.pregen.stock_fingerprint(value);self.expected['stock_content']=self.record['stock_content_sha256']
 def test_actual_sdk_stock_timestamp_admit_claim_callback(self):
  self.timestamp_stock();job=self.start();self.assertEqual(self.r.current_host_context(self.db,'u','c')['job_id'],job['job_id'])
 def test_baseline_strict_ns_rejects_real_sdk_timestamp(self):
  self.timestamp_stock();value={k:v for k,v in self.doc['summary_versions'][0].items() if k!='is_active'}
  with self.assertRaises(TypeError):self.ns.digest(value)
 def test_decoded_stock_timestamp_edit_rejected_after_begin(self):
  self.timestamp_stock();self.start();raw=self.db.rows[self.key];old=raw['summary_versions'][0]['created_at'];new=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123457000Z');self.assertNotEqual(str(old),str(new));raw['summary_versions'][0]['created_at']=new;self.db.put(self.key,raw)
  with self.assertRaises(Exception):self.r.current_host_context(self.db,'u','c')
 def test_precise_nested_stock_timestamp_deterministic(self):
  a={'nested':{'created_at':DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456789Z')},'text':'fictional Ω'};b=copy.deepcopy(a)
  self.assertEqual(self.pregen.stock_fingerprint(a),self.pregen.stock_fingerprint(a));self.assertNotEqual(a['nested']['created_at'].rfc3339(),b['nested']['created_at'].rfc3339());b['nested']['created_at']=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456788Z');self.assertNotEqual(self.pregen.stock_fingerprint(a),self.pregen.stock_fingerprint(b))
 def test_timestamp_string_or_dictionary_cannot_impersonate_type(self):
  value=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456789Z')
  for other in [value.rfc3339(),['firestore_timestamp',value.rfc3339()],{'timestamp':value.rfc3339()}]:self.assertNotEqual(self.pregen.stock_fingerprint(value),self.pregen.stock_fingerprint(other))
 def test_legacy_stock_fingerprints_are_unchanged(self):
  value={'title':'fictional Ω','emoji':'🌱'};self.assertEqual(self.r._stock_fingerprint({'protocol_revision':'old-completed'},value),self.ns.digest(value));self.assertNotEqual(self.r._stock_fingerprint({'protocol_revision':self.pregen.PROTOCOL},value),self.ns.digest(value))
 def test_unknown_storage_types_or_naive_datetime_rejected(self):
  from datetime import datetime
  for value in [object(),b'unknown',datetime(2026,10,25)]:
   with self.assertRaises(ValueError):self.pregen.stock_fingerprint(value)
 def test_nested_retained_timestamp_stays_strictly_unsupported_not_lossy(self):
  raw=copy.deepcopy(self.doc);raw['semantic_retained_completion_jobs_v1']['old-start']['canonical_user']['timestamp']=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456789Z')
  with self.assertRaises(TypeError):self.pregen.need_pregen_source(raw,self.parent,self.record)
 def test_readback_stock_active_flag_change_preserves_exact_fingerprint(self):
  value={'created_at':DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456789Z'),'overview':'fictional Ω','is_active':True}
  before=self.pregen.stock_fingerprint({k:v for k,v in value.items() if k!='is_active'});value['is_active']=False;self.assertEqual(before,self.pregen.stock_fingerprint({k:v for k,v in value.items() if k!='is_active'}));value['created_at']=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456788Z');self.assertNotEqual(before,self.pregen.stock_fingerprint({k:v for k,v in value.items() if k!='is_active'}))
 def test_offset_collision_is_rejected_before_fingerprinting(self):
  utc=DatetimeWithNanoseconds(2026,10,25,13,30,22,nanosecond=123456789,tzinfo=timezone.utc)
  offset=DatetimeWithNanoseconds(2026,10,25,13,30,22,nanosecond=123456789,tzinfo=timezone(timedelta(hours=1)))
  self.assertEqual(utc.rfc3339(),offset.rfc3339());self.assertNotEqual(utc.timestamp(),offset.timestamp())
  with self.assertRaisesRegex(ValueError,'stock_timestamp_utc_required'):self.pregen.stock_fingerprint(offset)
  self.assertEqual(self.pregen.stock_fingerprint(utc),self.pregen.stock_fingerprint(utc))
 def test_actual_sdk_snapshot_precision_loss_is_an_explicit_limit(self):
  # This observes an existing public SDK limit, NOT a raw-storage freshness pass.
  original=DatetimeWithNanoseconds.from_rfc3339('2026-10-25T13:30:22.123456789Z')
  snapshot=DocumentSnapshot(reference=SimpleNamespace(path='synthetic/source'),data={'created_at':original},exists=True,read_time=None,create_time=None,update_time=None)
  provided=snapshot.to_dict()['created_at'];self.assertNotEqual(original.rfc3339(),provided.rfc3339());self.assertEqual(provided.nanosecond,0)
  self.assertNotEqual(self.pregen.stock_fingerprint(original),self.pregen.stock_fingerprint(provided))
 def test_original_completed_admission_function_unchanged(self):
  original=ast.parse((W/'quarantine-recovery-v1/integration-v3/candidate/database/saved_source_recovery.py').read_text());candidate=ast.parse((ROOT/'candidate/database/saved_source_recovery.py').read_text())
  for name in ['admit','approved_parents','eligible','tag_of','_current_host_context']:
   get=lambda t:next(n for n in t.body if isinstance(n,ast.FunctionDef) and n.name==name)
   self.assertEqual(ast.dump(get(original),include_attributes=False),ast.dump(get(candidate),include_attributes=False))
if __name__=='__main__':unittest.main()
