 def mutate_after_full_remote_validation(self,mutation):
  original=self.deps.hydrate;fired=[]
  def hydrate(*a,**kw):
   snapshot=original(*a,**kw)  # Actual captured scope/require_ack, never forged stamp.
   if not fired:fired.append(True);mutation(self.db)
   return snapshot
  self.deps=replace(self.deps,hydrate=hydrate)
  return fired
 def assert_preflight_rejected_no_transaction(self,proposal):
  with self.assertRaises(self.pub.SemanticPublicationRejectedError):self.run_apply(proposal)
  self.assertEqual(self.db.begins,0);self.assertEqual(self.db.commits,0);self.assertEqual(self.canonical,[])
  self.assertNotIn('summary_writeback_receipt',self.db.rows[self.key])
 def test_reference_edit_between_remote_validation_and_after_pin_collection_rejects(self):
  proposal=self.accept();key=('users',self.r.uid,'conversations','context-a')
  fired=self.mutate_after_full_remote_validation(lambda db:db.put(key,{**db.rows[key],'structured':{**db.rows[key]['structured'],'title':'Changed during validation'}}))
  self.assert_preflight_rejected_no_transaction(proposal);self.assertEqual(len(fired),1)
 def test_delete_recreate_same_payload_changed_create_timestamp_rejects(self):
  proposal=self.accept();key=('users',self.r.uid,'conversations','context-a');before=copy.deepcopy(self.db.rows[key]);stamp=self.db.created[key]
  def recreate(db):
   payload=db.rows.pop(key);db.created.pop(key);db.put(key,payload,created=stamp+timedelta(seconds=1))
  self.mutate_after_full_remote_validation(recreate)
  self.assert_preflight_rejected_no_transaction(proposal);self.assertEqual(self.db.rows[key],before);self.assertNotEqual(self.db.created[key],stamp)
 def test_same_plaintext_changed_ciphertext_raw_pin_rejects(self):
  proposal=self.accept();key=('users',self.r.uid,'conversations','context-a');plain=copy.deepcopy(self.refdoc['transcript_segments'])
  # Explicit fake protection leaf: both synthetic encodings decode to IDENTICAL bytes.
  self.dbm.encryption=SimpleNamespace(decrypt_strict=lambda ciphertext,uid:copy.deepcopy(plain))
  self.db.put(key,{**self.db.rows[key],'data_protection_level':'enhanced','transcript_segments':'synthetic-ciphertext-A'})
  self.mutate_after_full_remote_validation(lambda db:db.put(key,{**db.rows[key],'transcript_segments':'synthetic-ciphertext-B'}))
  self.assert_preflight_rejected_no_transaction(proposal)
  self.assertEqual(self.dbm.encryption.decrypt_strict('synthetic-ciphertext-A',self.r.uid),self.dbm.encryption.decrypt_strict('synthetic-ciphertext-B',self.r.uid))
 def test_unrelated_new_record_outside_captured_cid_readset_allows_apply(self):
