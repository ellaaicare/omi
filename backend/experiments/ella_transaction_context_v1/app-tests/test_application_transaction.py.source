def load(name,path):
 s=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(s);sys.modules[name]=m;s.loader.exec_module(m);return m
def mod(name,**kw):
 m=types.ModuleType(name);m.__dict__.update(kw);return m
Q=load('synthetic_serializable_store',W/'tests/test_integrated_queue.py')
R=load('synthetic_actual_capture_rig',W/'captured-context-v2/tests/test_attempt_capture_scope.py')
def extract(name,path,names,env):
 tree=ast.parse(path.read_text());nodes=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)) and n.name in names]
 m=mod(name,**env);sys.modules[name]=m;exec(compile(ast.Module(nodes,type_ignores=[]),str(path),'exec'),m.__dict__);return m
class Tx(Q.Transaction):
 _read_only=False;_max_attempts=3
 def __init__(self,db):super().__init__(db);self._id=None
 @property
 def id(self):return self._id
 def _clean_up(self):self.reads={};self.writes=[];self._id=None
 def _begin(self,retry_id=None):self._id=b'synthetic';self.db.active+=1;self.db.begins+=1
 def _rollback(self):self.db.active=max(0,self.db.active-1);self.writes=[]
 def _commit(self):
  if self.db.before_commit:
   f=self.db.before_commit;self.db.before_commit=None;f(self.db)
  if any(self.db.versions.get(p,0)!=v for p,v in self.reads.items()):self.db.active-=1;self.db.conflicts+=1;raise Aborted('synthetic conflict')
  for action,p,v in self.writes:
   doc=copy.deepcopy(self.db.rows[p]) if action=='update' else {}
   for key,value in v.items():
    parent=doc;parts=key.split('.')
    for part in parts[:-1]:parent=parent.setdefault(part,{})
    parent[parts[-1]]=copy.deepcopy(value)
   self.db.put(p,doc)
  self.db.active-=1;self.db.commits+=1;self.writes=[]
  if self.db.after_commit:
   hook=self.db.after_commit;self.db.after_commit=None;hook(self.db)
class Store(Q.Store):
 def __init__(self):super().__init__();self.active=0;self.commits=0;self.before_commit=None;self.begins=0;self.conflicts=0;self.after_commit=None
 def transaction(self):return Tx(self)
 def get_all(self,refs,transaction=None,**kw):return [r.get(transaction=transaction) for r in refs]
class CategoryEnum(str,Enum):other='other'
