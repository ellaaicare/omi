  result=self.run_apply(proposal);self.assertEqual(result['status'],'completed');self.assertEqual(len(fired),1)
  self.assertEqual(self.db.rows[key],unrelated);self.assertEqual(len(self.canonical),1)
 def reject_accepted_authority_race(self,*,pending,mutation):
  proposal=self.accept();original=copy.deepcopy(self.db.rows[self.key]);self.run_apply(proposal)
  accepted=copy.deepcopy(self.pending if pending else self.db.rows[self.key]);self.canonical.clear();self.db.put(self.key,original)
  baseline_commits=self.db.commits
  def raced(db):
   db.put(self.key,accepted);mutation(db)
  self.db.before_commit=raced
  with self.assertRaises((self.pub.SemanticPublicationRejectedError,self.writer.CanonicalSummaryOperationConflictError,R.FENCE.FenceRejected)):
   self.run_apply(proposal)
  self.assertEqual(self.db.commits,baseline_commits);self.assertEqual(self.canonical,[])
  self.assertEqual(self.db.rows[self.key]['summary_versions'],accepted['summary_versions'])
