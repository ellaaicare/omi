 def test_revocation_after_new_cas_before_canonical_dispatch_preserves_pending(self):
  proposal=self.accept();self.db.after_commit=self.revoke_current_consent
  result=self.run_apply(proposal);current=self.db.rows[self.key]
  self.assertEqual(result['status'],'pending_reconciliation');self.assertEqual(self.canonical,[])
  self.assertNotEqual(current['active_summary_version_id'],'stock');self.assertEqual(current['summary_writeback_receipt']['status'],'pending_reconciliation')
  self.assertEqual(len(current['summary_versions']),2)
 def prepare_pending_dispatch_race(self,*,repair):
  proposal=self.accept();original=copy.deepcopy(self.db.rows[self.key]);self.run_apply(proposal)
  pending=copy.deepcopy(self.pending);self.canonical.clear();self.db.put(self.key,original)
  if repair:pending['structured']['title']='A synthetic later edit'
  def raced(db):
   db.put(self.key,pending)
   if repair:
    # After accepted read-only classifier, next actual repair-preparation CAS
    # must finish before revocation immediately ahead of canonical dispatch.
    db.after_commit=lambda db:setattr(db,'after_commit',self.revoke_current_consent)
   else:db.after_commit=self.revoke_current_consent
  self.db.before_commit=raced
  return proposal,pending
 def test_revocation_after_accepted_pending_before_dispatch_preserves_pending(self):
  proposal,pending=self.prepare_pending_dispatch_race(repair=False);result=self.run_apply(proposal);current=self.db.rows[self.key]
  self.assertEqual(result['status'],'pending_reconciliation');self.assertEqual(self.canonical,[])
  self.assertEqual(current['summary_versions'],pending['summary_versions']);self.assertEqual(current['summary_writeback_receipt']['status'],'pending_reconciliation')
 def test_revocation_after_supersession_repair_prepare_blocks_dispatch(self):
  proposal,pending=self.prepare_pending_dispatch_race(repair=True);result=self.run_apply(proposal);current=self.db.rows[self.key]
  self.assertEqual(result['status'],'pending_reconciliation');self.assertEqual(self.canonical,[])
  self.assertEqual(current['summary_versions'],pending['summary_versions']);self.assertEqual(current['summary_writeback_receipt']['status'],'pending_reconciliation')
  self.assertEqual(current['summary_writeback_receipt']['canonical_status'],'supersession_pending')
if __name__=='__main__':unittest.main()
