 def tearDown(self):
  self.p.stop();self.r.close();self.hostroot.stop();self.network.stop()
 def accept(self):
  r=self.r
  # Actual receipt core with sanitizer-valid synthetic summary.
  binding=self.pub.current_binding(r.doc,uid=r.uid,conversation_id=r.cid)
  candidate={'title':'Fictional notebook plan','overview':'In this fictional test, Mira plans to take the blue notebook to the library on Friday.','emoji':'📘','category':'other'}
  for role in ['generator','verifier']:
   changes,_=self.pub.record_completed_operation(r.doc,binding=binding,operation_id=role,candidate=candidate,role=role,runtime_interaction_id='runtime-'+role,canonical_assistant_event_id='event-'+role,verifier_result={'accepted':True,'source_grounded':True,'semantic_summary':True,'context_owner_verified':True} if role=='verifier' else None);r.doc.update(changes)
  changes,result=self.pub.issue_receipt(r.doc,binding=binding,candidate=candidate,generator_operation_id='generator',verifier_operation_id='verifier');r.doc.update(changes);self.db.put(self.key,r.doc)
  return {'publication_receipt_id':result['receipt_id'],'policy':'ella-semantic-summary-v1','policy_revision':binding.policy_revision,'candidate_schema_version':2,'semantic_contract_version':2,'summary':candidate,'candidate_sha256':self.pub.candidate_sha256(candidate)}
 def run_apply(self,proposal):
  bridge=self.apply.RetainedSemanticApply(uid=self.r.uid,conversation_id=self.r.cid,repository=None,read_conversation=lambda u,c:copy.deepcopy(self.db.rows[self.key]),dependencies=self.deps)
  return asyncio.run(bridge(proposal))
 def test_accepted_proposal_persists_canonical_new_version(self):
  result=self.run_apply(self.accept());self.assertEqual(result['status'],'completed');self.assertEqual(len(self.canonical),1)
  current=self.db.rows[self.key];self.assertNotEqual(current['active_summary_version_id'],'stock');self.assertEqual(current['summary_writeback_receipt']['status'],'completed');self.assertEqual(self.canonical[0]['structured']['title'],current['structured']['title'])
  self.assertEqual(current['transcript_segments'],self.r.doc['transcript_segments'])
  self.assertEqual(next(v for v in current['summary_versions'] if v['id']=='stock')['title'],'Fictional')
  projected=R.CAN.canonical_source_from_conversation(uid=self.r.uid,conversation_id=self.r.cid,conversation=self.canonical[0])
  self.assertEqual(projected,R.CAN.canonical_source_from_conversation(uid=self.r.uid,conversation_id=self.r.cid,conversation=current))
 def test_same_accepted_token_is_idempotent(self):
  proposal=self.accept();first=self.run_apply(proposal);version=self.db.rows[self.key]['active_summary_version_id'];second=self.run_apply(proposal)
  self.assertEqual(first['operation_receipt'],second['operation_receipt']);self.assertEqual(self.db.rows[self.key]['active_summary_version_id'],version);self.assertEqual(len(self.canonical),1)
 def test_commit_conflict_retries_real_sdk_callback_without_leaking_writes(self):
  proposal=self.accept();before=self.db.commits
  self.db.before_commit=lambda db:db.put(self.key,copy.deepcopy(db.rows[self.key]))
  result=self.run_apply(proposal);self.assertEqual(result['status'],'completed');self.assertEqual(len(self.canonical),1);self.assertEqual(self.db.commits-before,2);self.assertEqual(self.db.conflicts,1);self.assertEqual(self.db.begins,3)
 def reject_race(self,mutation):
  proposal=self.accept();before=copy.deepcopy(self.db.rows[self.key]);self.db.before_commit=mutation
  with self.assertRaises((self.writer.ConversationSummaryOutcomeUnknownError,self.pub.SemanticPublicationRejectedError,R.FENCE.FenceRejected)):self.run_apply(proposal)
  self.assertEqual(len(self.db.rows[self.key]['summary_versions']),1);self.assertNotIn('summary_writeback_receipt',self.db.rows[self.key]);self.assertEqual(self.canonical,[])
