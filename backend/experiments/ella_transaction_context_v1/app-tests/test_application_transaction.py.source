 def accepted_race(self,change=None):
  proposal=self.accept();original=copy.deepcopy(self.db.rows[self.key]);self.run_apply(proposal)
  completed=copy.deepcopy(self.db.rows[self.key]);self.canonical.clear();self.db.put(self.key,original)
  if change:change(completed)
  self.db.before_commit=lambda db:db.put(self.key,completed)
  return proposal,completed
 def test_exact_accepted_receipt_commit_race_reconciles_no_second_version(self):
  proposal,completed=self.accepted_race();result=self.run_apply(proposal)
  self.assertEqual(result['status'],'completed');self.assertEqual(self.db.rows[self.key]['summary_versions'],completed['summary_versions']);self.assertEqual(self.canonical,[])
 def test_exact_pending_receipt_commit_race_finishes_owned_reconciliation(self):
  proposal=self.accept();original=copy.deepcopy(self.db.rows[self.key]);self.run_apply(proposal)
  pending=copy.deepcopy(self.pending);self.canonical.clear();self.db.put(self.key,original)
  self.db.before_commit=lambda db:db.put(self.key,pending)
  result=self.run_apply(proposal);current=self.db.rows[self.key]
  self.assertEqual(result['status'],'completed');self.assertEqual(current['summary_versions'],pending['summary_versions']);self.assertEqual(len(self.canonical),1)
