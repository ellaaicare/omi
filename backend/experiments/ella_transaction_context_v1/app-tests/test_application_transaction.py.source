  env=dict(vars(typing));env.update(copy=copy,datetime=datetime,timezone=timezone,uuid=__import__('uuid'),uuid4=uuid4,transactional=transactional,db=self.db,conversations_collection='conversations',_prepare_conversation_for_read=lambda d,u:copy.deepcopy(d),_prepare_conversation_for_write=lambda d,u,l:copy.deepcopy(d))
